---
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
  headings?: { depth: number; slug: string; text: string }[];
  /** Links to every page of a multi-page document, such as the guide, shown in the sidebar above "On this page",
   * under their group's name when they have one. */
  pages?: { href: string; title: string; current?: boolean; group?: string; color?: string }[];
}
const { title, description, headings = [], pages = [] } = Astro.props;
const pageGroups = [...new Set(pages.map((p) => p.group))].map((group) => ({ group, color: pages.find((p) => p.group === group)?.color, links: pages.filter((p) => p.group === group) }));
const toc = headings.filter((h) => h.depth === 2);
const side = toc.length > 0 || pages.length > 0 || Astro.slots.has('side');
---

<Base title={title} description={description}>
  <div id="top" class={`wrap doc ${side ? 'with-side' : ''}`}>
    {side && (
      <div class="side">
        <slot name="side" />
        {pages.length > 0 && (
          <nav class="toc pages card solid" aria-label="Guide pages">
            <details>
              <summary>Guide pages</summary>
              {pageGroups.map(({ group, color, links }) => (
                <div class="group" style={color ? `--dot: var(--${color})` : undefined}>
                  {group && <p class="group-name">{group}</p>}
                  <ul>{links.map((p) => <li><a href={p.href} aria-current={p.current ? 'page' : undefined}>{p.title}</a></li>)}</ul>
                </div>
              ))}
            </details>
          </nav>
        )}
        {toc.length > 0 && (
          <nav class="toc on-page card solid" aria-label="On this page">
            <details>
              <summary>On this page</summary>
              <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
            </details>
          </nav>
        )}
      </div>
    )}
    <article class="prose card solid">
      <slot />
    </article>
  </div>
  {toc.length > 0 && <a class="to-top button small white" href="#top" hidden>↑ Back to top</a>}
</Base>

<style>
  .doc { display: grid; gap: 24px; padding-block: 40px 24px; }
  .doc:not(.with-side) { max-width: 820px; }
  .side { display: grid; gap: 16px; min-width: 0; }
  @media (min-width: 1000px) {
    .doc.with-side { grid-template-columns: 250px 1fr; align-items: start; }
    /* The sidebar scrolls on its own when it's taller than the window; the padding keeps the cards' shadows in view. */
    .side { position: sticky; top: 96px; max-height: calc(100dvh - 112px); overflow-y: auto; padding: 0 6px 6px 0; margin-right: -6px; }
  }
  .toc { padding: 16px 18px; font-size: 15px; }
  .toc summary { font-weight: 900; cursor: pointer; }
  .toc details[open] summary { margin-bottom: 8px; }
  .toc ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  @media (max-width: 999px) { .toc ul { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); } }
  .toc a { display: block; padding: 3px 8px; margin-inline: -8px; border-radius: 6px; text-decoration: none; font-weight: 600; }
  .toc a:hover { background: var(--well); }
  .toc a[aria-current] { background: var(--yellow); color: var(--on-accent); font-weight: 800; }
  .pages a[aria-current] { background: var(--dot, var(--pink)); }
  @media (prefers-reduced-motion: no-preference) {
    .toc a { transition: transform 180ms var(--ease-out), background-color 150ms; }
    .toc a:hover { transform: translateX(4px); }
    /* The marker wipes in each time it moves, on the pages list and on "On this page". */
    .toc a[aria-current] { animation: wipe 600ms 150ms var(--ease-out) both; }
  }
  @keyframes wipe { from { clip-path: inset(0 100% 0 0); } }
  .group + .group { margin-top: 12px; }
  .group-name { display: flex; align-items: center; gap: 8px; margin: 0 0 4px; font: 800 12px/1.4 var(--font); letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .group-name::before { content: ""; width: 10px; height: 10px; border: 2px solid var(--line); border-radius: 50%; background: var(--dot, var(--yellow)); }
  .to-top { position: fixed; right: 16px; bottom: 16px; z-index: 10; }
  .to-top[hidden] { display: none; }
  article { min-width: 0; }
</style>

<script>
  // Mark the section being read in "On this page", and offer a way back up once the title has scrolled away.
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('.on-page a')].map((a) => [a.hash.slice(1), a]));
  const headings = [...document.querySelectorAll<HTMLElement>('.prose h2[id]')].filter((h) => links.has(h.id));
  const title = document.querySelector('.prose h1');
  const toTop = document.querySelector<HTMLElement>('.to-top');

  // The current section is the last one whose heading has passed the top third of the window.
  const mark = () => {
    const line = innerHeight * 0.34;
    const current = headings.findLast((h) => h.getBoundingClientRect().top <= line);
    for (const [id, a] of links) {
      if (id === current?.id) a.setAttribute('aria-current', 'location');
      else a.removeAttribute('aria-current');
    }
  };
  // The observed area runs from far above the window down to that line, so every heading that crosses it fires,
  // even when a single jump (End, Page Down, a dragged scrollbar) carries it past.
  const sections = new IntersectionObserver(mark, { rootMargin: '100000px 0px -66% 0px' });
  headings.forEach((h) => sections.observe(h));

  // The sidebar's lists start collapsed so they don't push the guide down on phones; the wide layout opens them.
  const details = document.querySelectorAll<HTMLDetailsElement>('.toc details');
  const wide = matchMedia('(min-width: 1000px)');
  const fit = () => details.forEach((d) => (d.open = wide.matches));
  fit();
  wide.addEventListener('change', fit);

  if (title && toTop) {
    new IntersectionObserver(([entry]) => (toTop.hidden = entry.isIntersecting || entry.boundingClientRect.top > 0)).observe(title);
  }
</script>
