---
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  headings?: { depth: number; slug: string; text: string }[];
  /** Links to every page of a multi-page document, such as the guide, in the left column under their group's name.
   * `color` is the token behind the group's marker. Passing pages gives the guide's three columns and "Shot guide" header.
   * Without it, the page is long-form text (privacy, other screenshot apps): the guide's article style in one centred column. */
  pages?: { href: string; title: string; current?: boolean; group?: string; color?: string }[];
}
const { title, description, image, imageAlt, headings = [], pages = [] } = Astro.props;
const guide = pages.length > 0;
const pageGroups = [...new Set(pages.map((p) => p.group))].map((group) => ({ group, color: pages.find((p) => p.group === group)?.color, links: pages.filter((p) => p.group === group) }));
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={title} description={description} image={image} imageAlt={imageAlt} wide={guide} guide={guide}>
  <slot name="header" slot="header" />
  {guide ? (
    <div id="top" class="wrap guide-layout">
      <nav class="guide-pages" aria-label="Guide pages">
        <details open>
          <summary>Guide pages</summary>
          {pageGroups.map(({ group, color, links }) => (
            <div class="group" style={color ? `--dot: var(--${color})` : undefined}>
              {group && <p class="group-name">{group}</p>}
              <ul>{links.map((p) => <li><a href={p.href} aria-current={p.current ? 'page' : undefined}>{p.title}</a></li>)}</ul>
            </div>
          ))}
        </details>
      </nav>
      <article class="prose guide-article">
        <slot />
      </article>
      {(toc.length > 0 || Astro.slots.has('rail')) && (
        <div class="guide-rail">
          {toc.length > 0 && (
            <nav class="on-page" aria-label="On this page">
              <details open>
                <summary>On this page</summary>
                <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
              </details>
            </nav>
          )}
          <slot name="rail" />
        </div>
      )}
    </div>
  ) : (
    <div id="top" class="narrow longform">
      <article class="prose longform-article">
        <slot />
      </article>
    </div>
  )}
  {toc.length > 0 && <a class="to-top button small white" href="#top" hidden>↑ Back to top</a>}
</Base>

<style>
  .longform { padding-block: 36px 24px; }
  article { min-width: 0; }

  /* The guide: the page list, the article and "On this page" side by side on wide screens (the board's 1360 px container).
     Between 1000 and 1280 px "On this page" moves under the page list; on phones both become rows above the article. */
  .guide-layout { display: grid; gap: 12px; padding-block: 12px 24px; }
  .guide-article { order: 1; margin-top: 16px; padding: 0; }
  @media (min-width: 1000px) {
    .guide-layout { grid-template-columns: 230px minmax(0, 760px); grid-template-rows: auto 1fr; gap: 28px 44px; justify-content: center; align-items: start; padding-top: 36px; }
    .guide-pages { grid-column: 1; grid-row: 1; }
    .guide-rail { grid-column: 1; grid-row: 2; }
    .guide-article { grid-column: 2; grid-row: 1 / span 2; margin-top: 0; }
  }
  @media (min-width: 1280px) {
    .guide-layout { grid-template-columns: minmax(200px, 250px) minmax(0, 760px) minmax(180px, 220px); grid-template-rows: auto; justify-content: space-between; }
    .guide-article { grid-row: 1; }
    .guide-rail { grid-column: 3; grid-row: 1; position: sticky; top: 24px; }
  }

  nav ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  nav a { display: block; text-decoration: none; }

  /* Phones: each list is a quiet card that opens. Wide screens open them (the script below) and drop the card. */
  details { background: var(--surface); border-radius: var(--radius-card); box-shadow: 0 0 0 1px var(--hairline); padding: 10px 16px; }
  summary { display: flex; align-items: center; min-height: 32px; font-weight: 800; font-size: 15px; cursor: pointer; }
  details[open] summary { margin-bottom: 10px; }
  @media (min-width: 1000px) {
    details { background: none; box-shadow: none; padding: 0; }
    summary { list-style: none; pointer-events: none; }
    summary::-webkit-details-marker { display: none; }
    .guide-pages summary { display: none; }
    .on-page summary { min-height: 0; padding: 0 12px; margin-bottom: 8px; font-size: 12.5px; }
  }

  /* The page list: a colour marker for each group, and the current page as a yellow ink chip. */
  .guide-pages { font-size: 14px; }
  .group + .group { margin-top: 20px; }
  .group-name { display: flex; align-items: center; gap: 8px; margin: 0; padding: 0 10px 6px; font-size: 12.5px; font-weight: 800; }
  .group-name::before { content: ""; flex: none; width: 10px; height: 10px; border-radius: 3px; background: var(--dot, var(--accent)); box-shadow: inset 0 0 0 1px rgb(22 22 26 / 0.2); }
  .guide-pages a { padding: 6px 10px; border-radius: 9px; line-height: 1.4; transition: background-color 150ms; }
  .guide-pages a:hover { background: var(--hover); }
  .guide-pages a[aria-current] { font-weight: 700; color: var(--on-accent); background: var(--accent); box-shadow: inset 0 0 0 1.5px var(--line), 0 2px 0 var(--line); }
  @media (max-width: 999px) {
    .guide-pages ul { grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); }
    .group + .group { margin-top: 14px; }
  }

  /* On this page: a grey track down the side, with the section you're reading marked in red. */
  .on-page { font-size: 13.5px; }
  .on-page a { padding: 4px 12px; line-height: 1.4; color: var(--tertiary); box-shadow: inset 3px 0 0 var(--hairline); transition: color 150ms, box-shadow 150ms; }
  .on-page a:hover { color: var(--ink); }
  .on-page a[aria-current] { color: var(--ink); font-weight: 700; box-shadow: inset 3px 0 0 var(--record); }

  .to-top { position: fixed; right: 16px; bottom: 16px; z-index: 10; }
  .to-top[hidden] { display: none; }
</style>

<style is:global>
  /* Long-form pages: the guide's article (board "Site · guide page") without its side columns.
     The page opens with a .longform-head: a meta line, the title with the highlighter under one word, and the lede. */
  .prose.longform-article { display: grid; gap: 22px; padding: 0; font-size: 16.5px; line-height: 1.65; }
  .prose.longform-article > * { margin: 0; min-width: 0; }
  .prose.longform-article .longform-head { display: grid; gap: 12px; }
  .prose.longform-article .longform-head > * { margin: 0; }
  .prose.longform-article .longform-meta { font-size: 13px; font-weight: 700; color: var(--tertiary); }
  .prose.longform-article .longform-head .lede { max-width: 40em; }
  .prose.longform-article h2 { margin: 18px 0 0; padding: 0; border: 0; line-height: 1.15; scroll-margin-top: 24px; }
  .prose.longform-article h2 + * { margin-top: -8px; }
  .prose.longform-article ul { display: grid; gap: 10px; margin: 0; }
  .prose.longform-article li { margin: 0; padding-left: 4px; }
  /* The install command (Copy.astro) keeps its own type on the dark band, not .prose's inline code. */
  .prose.longform-article .copy code { padding: 0; font-size: 13.5px; background: none; border-radius: 0; }
</style>

<script>
  // Mark the section being read in "On this page", and offer a way back up once the title has scrolled away.
  const links = new Map<string, HTMLAnchorElement>();
  for (const a of document.querySelectorAll<HTMLAnchorElement>('.on-page a')) links.set(a.hash.slice(1), a);
  const headings = [...document.querySelectorAll<HTMLElement>('.prose h2[id]')].filter((h) => links.has(h.id));
  const title = document.querySelector('.prose h1');
  const toTop = document.querySelector<HTMLElement>('.to-top');

  // The current section is the last one whose heading has passed the top third of the window.
  const mark = () => {
    const line = innerHeight * 0.34;
    const current = headings.findLast((h) => h.getBoundingClientRect().top <= line);
    for (const [id, a] of links) {
      if (id === current?.id) a.setAttribute('aria-current', 'location');
      else a.removeAttribute('aria-current');
    }
  };
  // The observed area runs from far above the window down to that line, so every heading that crosses it fires,
  // even when a single jump (End, Page Down, a dragged scrollbar) carries it past.
  const sections = new IntersectionObserver(mark, { rootMargin: '100000px 0px -66% 0px' });
  headings.forEach((h) => sections.observe(h));

  // The lists start open, so they show without this script. On phones they close, so they don't push the guide down.
  const details = document.querySelectorAll<HTMLDetailsElement>('.guide-layout details');
  const wide = matchMedia('(min-width: 1000px)');
  // Wide screens show the lists' contents only, so their summaries leave the Tab order too.
  const fit = () =>
    details.forEach((d) => {
      d.open = wide.matches;
      d.querySelector('summary')!.tabIndex = wide.matches ? -1 : 0;
    });
  fit();
  wide.addEventListener('change', fit);

  if (title && toTop) {
    new IntersectionObserver(([entry]) => (toTop.hidden = entry.isIntersecting || entry.boundingClientRect.top > 0)).observe(title);
  }
</script>
