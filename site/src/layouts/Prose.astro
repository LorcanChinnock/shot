---
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
  headings?: { depth: number; slug: string; text: string }[];
}
const { title, description, headings = [] } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={title} description={description}>
  <div class={`wrap doc ${toc.length ? 'with-toc' : ''}`}>
    {toc.length > 0 && (
      <nav class="toc card solid" aria-label="On this page">
        <strong>On this page</strong>
        <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
      </nav>
    )}
    <article class="prose card solid">
      <slot />
    </article>
  </div>
</Base>

<style>
  .doc { display: grid; gap: 24px; padding-block: 40px 24px; }
  .doc:not(.with-toc) { max-width: 820px; }
  @media (min-width: 1000px) {
    .doc.with-toc { grid-template-columns: 230px 1fr; align-items: start; }
    .toc { position: sticky; top: 96px; }
  }
  .toc { padding: 16px 18px; font-size: 15px; }
  .toc strong { display: block; font-weight: 900; margin-bottom: 8px; }
  .toc ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  @media (max-width: 999px) { .toc ul { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); } }
  .toc a { display: block; padding: 3px 8px; margin-inline: -8px; border-radius: 6px; text-decoration: none; font-weight: 600; }
  .toc a:hover { background: rgb(18 18 26 / 0.07); }
  article { min-width: 0; }
</style>
