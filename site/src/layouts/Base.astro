---
import '../styles/global.css';
import { latestRelease } from '../lib/release';

interface Props {
  title?: string;
  description?: string;
  /** A wider page, for the guide's three columns. */
  wide?: boolean;
  /** A card for this page's link previews, as a path under /; every page without one shares /og.png. */
  image?: string;
  imageAlt?: string;
  /** Keeps the page out of search results. */
  noindex?: boolean;
}

const {
  title,
  wide = false,
  description = 'A screenshot, annotation and screen recording app for the Mac menu bar. Free and open source.',
  image = '/og.png',
  imageAlt = "Shot's menu bar app: a better ⌘⇧4. A support ticket with a highlighted line, an arrow and a note, and the Quick Access card saying Copied. Free and open source, for Mac.",
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} · Shot` : 'Shot: screenshots and screen recording for macOS';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const release = await latestRelease();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => (path === href ? 'page' : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f6f4ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#17161b" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Shot" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" type="application/rss+xml" title="Shot releases" href="/changelog/rss.xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <slot name="head" />
  </head>
  <body class={wide ? 'wide' : undefined}>
    <a class="skip" href="#main">Skip to content</a>
    <div class="backdrop" aria-hidden="true">
      <div class="blob pink"></div>
      <div class="blob yellow"></div>
      <div class="blob mint"></div>
      <div class="blob sky"></div>
    </div>

    <header class="site-header wrap">
      <div class="bar card solid">
        <a class="brand" href="/">
          <img src="/icon-64.png" alt="" width="32" height="32" />
          <span>Shot<sup>beta</sup></span>
        </a>
        <nav aria-label="Main">
          <a href="/docs/get-started/" aria-current={current('/docs')}>Guide</a>
          <a class="hide-sm" href="/changelog/" aria-current={current('/changelog')}>Changelog</a>
          <a class="hide-sm" href="https://github.com/LorcanChinnock/shot">GitHub</a>
          <a class="hide-sm" href="/sponsor">Sponsor</a>
          <a class="button small" href="/download" title={`Download Shot ${release.version}`}>Download</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer wrap">
      <div class="bar card">
        <div class="top">
          <a class="brand" href="/">
            <img src="/icon-64.png" alt="" width="32" height="32" />
            <span>Shot</span>
          </a>
          <nav aria-label="Footer">
            <a href="/docs/get-started/">Guide</a>
            <a href="/changelog/">Changelog</a>
            <a href="/screenshot-apps/">Other screenshot apps</a>
            <a href="/privacy/">Privacy</a>
            <a href="https://github.com/LorcanChinnock/shot">Source</a>
            <a href="https://github.com/LorcanChinnock/shot/issues">Report a bug</a>
            <a href="/sponsor">Sponsor</a>
            <a href="https://github.com/LorcanChinnock/shot/blob/main/LICENSE">GPL-3.0 license</a>
          </nav>
        </div>
        <p class="credit">
          <a class="mark" href="https://lorcanchinnock.com"><b aria-hidden="true">LC<i>_</i></b><span>Made by Lorcan Chinnock</span></a>
          <span>Not affiliated with Apple.</span>
        </p>
      </div>
    </footer>
  </body>
</html>
