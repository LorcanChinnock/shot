---
import '../styles/global.css';
import { latestRelease } from '../lib/release';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = 'A screenshot, annotation and screen recording app for the Mac menu bar. Free and open source.',
} = Astro.props;
const fullTitle = title ? `${title} · Shot` : 'Shot: screenshots and screen recording for macOS';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const release = await latestRelease();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => (path === href ? 'page' : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f6f4ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#17161b" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Shot" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Shot's yellow icon beside the words: A screenshot app that sits in your Mac's menu bar. Free and open source." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap.xml" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="backdrop" aria-hidden="true">
      <div class="blob pink"></div>
      <div class="blob yellow"></div>
      <div class="blob mint"></div>
      <div class="blob sky"></div>
    </div>

    <header class="site-header wrap">
      <div class="bar card solid">
        <a class="brand" href="/">
          <img src="/icon-64.png" alt="" width="32" height="32" />
          <span>Shot<sup>beta</sup></span>
        </a>
        <nav aria-label="Main">
          <a href="/docs/" aria-current={current('/docs')}>Guide</a>
          <a class="hide-sm" href="/changelog/" aria-current={current('/changelog')}>Changelog</a>
          <a class="hide-sm" href="https://github.com/LorcanChinnock/shot">GitHub</a>
          <a class="hide-sm" href="/sponsor">Sponsor</a>
          <a class="button small" href="/download" title={`Download Shot ${release.version}`}>Download</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer wrap">
      <div class="bar card">
        <div class="top">
          <a class="brand" href="/">
            <img src="/icon-64.png" alt="" width="32" height="32" />
            <span>Shot</span>
          </a>
          <nav aria-label="Footer">
            <a href="/docs/">Guide</a>
            <a href="/changelog/">Changelog</a>
            <a href="/privacy/">Privacy</a>
            <a href="https://github.com/LorcanChinnock/shot">Source</a>
            <a href="https://github.com/LorcanChinnock/shot/issues">Report a bug</a>
            <a href="/sponsor">Sponsor</a>
            <a href="https://github.com/LorcanChinnock/shot/blob/main/LICENSE">GPL-3.0 license</a>
          </nav>
        </div>
        <p class="credit">
          <a class="mark" href="https://lorcanchinnock.com"><b aria-hidden="true">LC<i>_</i></b><span>Made by Lorcan Chinnock</span></a>
          <span>Not affiliated with Apple.</span>
        </p>
      </div>
    </footer>
  </body>
</html>
