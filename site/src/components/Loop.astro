---
/** A muted, looping clip converted from the MP4s in docs/media by scripts/media.sh. */
interface Props {
  name: string;
  label: string;
  eager?: boolean;
}
const { name, label, eager = false } = Astro.props;
---

<video
  class="loop"
  autoplay
  muted
  loop
  playsinline
  disablepictureinpicture
  preload={eager ? 'auto' : 'none'}
  poster={`/media/${name}.webp`}
  width="960"
  height="600"
  aria-label={label}
>
  <source src={`/media/${name}.webm`} type="video/webm" />
  <source src={`/media/${name}.mp4`} type="video/mp4" />
</video>

<script>
  import '../scripts/loops.ts';
</script>
