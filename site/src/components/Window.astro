---
/**
 * A product shot on a pastel panel, as the landing page shows them: the shot sits tilted with a deep shadow, and
 * straightens and lifts on hover. Marks go in the `marks` slot, positioned against the shot (not the panel).
 */
interface Props {
  tone?: 'sand' | 'lilac' | 'sky' | 'blush' | 'sage';
  /** The resting tilt, such as "-1deg". */
  tilt?: string;
  class?: string;
}
const { tone = 'sand', tilt = '-1deg', class: className } = Astro.props;
---

<figure class:list={['shot-panel panel', tone, className]}>
  <div class="shot-anchor">
    <div class="shot-frame tilt" style={`--tilt: ${tilt}`}><slot /></div>
    <slot name="marks" />
  </div>
</figure>

<style>
  .shot-panel { margin: 0; padding: clamp(16px, 3vw, 34px); display: grid; place-items: center; border-radius: 28px; }
  .shot-anchor { position: relative; width: 100%; }
  .shot-frame { overflow: hidden; border-radius: 14px; box-shadow: 0 0 0 1px rgb(22 22 26 / 0.06), 0 30px 60px rgb(40 30 60 / 0.22); }
  .shot-frame :global(img), .shot-frame :global(video) { width: 100%; }
</style>
