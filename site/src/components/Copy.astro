---
/** A one-line shell command on the dark band, with a Copy button that says Copied ✓. */
interface Props {
  command: string;
}
const { command } = Astro.props;
// Let a long command wrap after its slashes on narrow screens, instead of scrolling out of sight.
const parts = command.split('/');
---

<div class="copy">
  <code>{parts.map((part, i) => (i ? <Fragment>/<wbr />{part}</Fragment> : part))}</code>
  <button type="button" data-copy={command}>Copy</button>
  <span class="status" aria-live="polite"></span>
</div>

<style>
  .copy {
    display: flex; align-items: center; gap: 10px;
    min-width: 0; max-width: 100%;
    padding: 6px 6px 6px 14px;
    color: var(--band-text); background: var(--band);
    border-radius: 14px;
  }
  code { flex: 1; min-width: 0; font: 600 13.5px/1.45 var(--mono); overflow-wrap: anywhere; }
  /* Generated content, so selecting the command (triple-click included) never picks up the prompt. */
  code::before { content: '$ '; color: var(--accent); font-weight: 700; }
  button {
    flex: none; min-width: 84px; min-height: 36px; padding: 7px 13px;
    font: 800 13px/1.2 var(--font); color: #16161a;
    background: #fff;
    border: 1.5px solid #000; border-radius: 9px;
    box-shadow: 0 2px 0 #000;
    cursor: pointer;
    transition: transform var(--press), box-shadow var(--press), background-color 200ms;
  }
  button:active { transform: translateY(2px); box-shadow: 0 0 0 #000; }
  button.done { background: var(--copied); }
  button:focus-visible { outline-color: var(--band-text); }
  .status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) {
    button:active { transform: none; box-shadow: 0 2px 0 #000; filter: brightness(0.92); }
  }
</style>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    // Screen readers don't reliably read a button's new label, so the live region says it too.
    const status = button.nextElementSibling!;
    let reset: ReturnType<typeof setTimeout> | undefined;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy!);
        button.textContent = 'Copied ✓';
        button.classList.add('done');
        status.textContent = 'Copied to the clipboard';
      } catch {
        button.textContent = 'Press ⌘C';
        status.textContent = 'Selected. Press Command-C to copy.';
        const range = document.createRange();
        range.selectNodeContents(button.previousElementSibling!);
        getSelection()?.removeAllRanges();
        getSelection()?.addRange(range);
      }
      clearTimeout(reset);
      reset = setTimeout(() => {
        button.textContent = 'Copy';
        button.classList.remove('done');
        status.textContent = '';
      }, 1600);
    });
  }
</script>
