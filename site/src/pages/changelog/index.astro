---
import Base from '../../layouts/Base.astro';
import ChangelogRelease from '../../components/ChangelogRelease.astro';
import { highlights } from '../../data/changelog-highlights';
import { readChangelog } from '../../lib/changelog';

const releases = await readChangelog();
// The newest releases show; the rest wait behind "Show older releases".
const shown = 8;
const recent = releases.slice(0, shown);
const older = releases.slice(shown);
const filters = [
  { id: 'all', label: 'Everything' },
  { id: 'new', label: 'New' },
  { id: 'fixes', label: 'Fixes' },
];
---

<Base title="Changelog" description="What changed in each Shot release, newest first, with every new feature and fix.">
  <div class="changelog">
    <header class="wrap changelog-head">
      <div class="changelog-title">
        <h1>What’s <span class="hl">new</span></h1>
        <p class="lede">Every release, newest first. Shot updates itself once you allow it to.</p>
      </div>
      <div class="changelog-tools">
        <a class="button secondary rss" href="/changelog/rss.xml">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" aria-hidden="true"><path d="M5 19h.01M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"></path></svg>
          RSS feed
        </a>
        <fieldset class="show">
          <legend class="visually-hidden">Show</legend>
          {filters.map((f, i) => (
            <label>
              <input class="visually-hidden" type="radio" name="show" value={f.id} id={`show-${f.id}`} checked={i === 0} />
              {f.label}
            </label>
          ))}
        </fieldset>
      </div>
    </header>

    <div class="wrap changelog-body">
      <ol class="timeline" aria-label="Releases">
        {recent.map((release, i) => <ChangelogRelease release={release} latest={i === 0} highlight={highlights[release.version]} />)}
      </ol>
      {older.length > 0 && (
        <details class="older">
          <summary class="button secondary">
            <span class="when-closed">Show {older.length} older releases</span>
            <span class="when-open">Hide older releases</span>
          </summary>
          <ol class="timeline" aria-label="Older releases">
            {older.map((release) => <ChangelogRelease release={release} highlight={highlights[release.version]} />)}
          </ol>
        </details>
      )}
      <p class="changelog-empty">Nothing in these releases matches. Pick Everything to see them all.</p>
    </div>
  </div>
</Base>

<style is:global>
  /* The title, the RSS link and the filters, from the board "Site · changelog". */
  .changelog-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px; padding-block: 56px 40px; }
  .changelog-title { display: grid; gap: 14px; }
  .changelog-title .lede { margin: 0; max-width: 520px; }
  .changelog-tools { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .changelog .rss { min-height: 40px; padding: 8px 14px; gap: 8px; font-size: 14px; }
  .changelog .rss svg { color: #b35a00; }
  @media (prefers-color-scheme: dark) { .changelog .rss svg { color: #ffa94d; } }

  /* Everything, New and Fixes: radio labels that look like a segmented control, so filtering needs no script. */
  .changelog .show { display: flex; margin: 0; padding: 3px; border: 0; border-radius: 12px; background: var(--surface); box-shadow: 0 0 0 1px var(--edge); font-size: 14px; }
  .changelog .show label { display: inline-flex; align-items: center; min-height: 34px; padding: 4px 13px; border-radius: 9px; font-weight: 500; cursor: pointer; transition: background-color 120ms; }
  .changelog .show label:hover { background: var(--hover); }
  .changelog .show label:has(:checked) { font-weight: 700; color: var(--on-accent); background: var(--accent); box-shadow: inset 0 0 0 1.5px var(--line); }
  .changelog .show label:has(:focus-visible) { outline: 2.5px solid var(--ink); outline-offset: 2px; }

  .changelog:has(#show-new:checked) .entry:not(.is-new),
  .changelog:has(#show-new:checked) .changelog-release:not(:has(.is-new)),
  .changelog:has(#show-fixes:checked) .entry:not(.is-fix),
  .changelog:has(#show-fixes:checked) .changelog-release:not(:has(.is-fix)) { display: none; }
  .changelog-empty { display: none; margin: 0 0 24px; color: var(--muted); }
  .changelog:has(#show-new:checked) .changelog-body:not(:has(.is-new)) .changelog-empty,
  .changelog:has(#show-fixes:checked) .changelog-body:not(:has(.is-fix)) .changelog-empty { display: block; }

  /* The timeline: each release's version and date on the left, with a dot on a line, and its card on the right. */
  .changelog-body { padding-bottom: 72px; }
  .timeline { list-style: none; margin: 0; padding: 0; }
  .changelog-release { position: relative; display: grid; grid-template-columns: 260px minmax(0, 1fr); align-items: start; gap: 20px 40px; padding-bottom: 44px; }
  .changelog-release::before { content: ""; position: absolute; left: 7px; top: 32px; bottom: 6px; width: 2px; border-radius: 1px; background: var(--edge); }
  .release-meta { display: grid; grid-template-columns: 16px auto; align-content: start; justify-items: start; gap: 6px 16px; }
  .release-meta > :not(.release-dot) { grid-column: 2; }
  .release-dot { grid-row: 1; width: 16px; height: 16px; margin-top: 7px; border-radius: 50%; background: var(--ink); box-shadow: 0 0 0 3px var(--bg); }
  .changelog-release.latest .release-dot { background: var(--record); }
  .changelog-release h2 { grid-row: 1; font: 700 22px/1.4 var(--mono); letter-spacing: -0.02em; }
  .changelog-release h2 a { color: inherit; text-decoration: none; }
  .changelog-release h2 a:hover { text-decoration: underline; }
  .changelog-release time { font-size: 14px; color: var(--tertiary); }
  .changelog-release .badge { margin-top: 4px; }

  .release-card { display: grid; gap: 16px; padding: 24px 26px; }
  .release-card.ink-card { border-radius: 20px; }
  .release-card .summary { margin: 0; }

  /* "Big one": a sticky note across the top of a release that changed a lot. */
  .big-one { display: flex; align-items: center; gap: 14px; margin: 0; padding: 12px 16px; border-radius: 14px; background: var(--note); color: var(--note-text); font-weight: 600; }
  .big-one-label { flex: none; font: 700 26px/1 var(--hand); color: var(--note-heading); transform: rotate(-4deg); white-space: nowrap; }

  .entries { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .entry { display: grid; grid-template-columns: 62px minmax(0, 1fr) auto; gap: 4px 12px; align-items: baseline; }
  .entry .kind { padding: 1px 0; border-radius: 6px; font-size: 11.5px; font-weight: 800; text-align: center; color: var(--muted); background: var(--control); }
  .entry .kind.new { color: var(--bg); background: var(--ink); }
  .entry .kind.changed { color: var(--ink); background: none; box-shadow: inset 0 0 0 1.5px var(--ink); }
  .entry .change { font-size: 15.5px; line-height: 1.55; }
  .entry .change code { font-size: 0.86em; padding: 0.1em 0.35em; background: var(--well); border-radius: 5px; }
  .entry .tag { white-space: nowrap; }
  .entry .pr { font: 500 12.5px/1.6 var(--mono); color: var(--tertiary); }

  /* Show older releases. */
  .older > summary { display: flex; width: fit-content; margin: 8px auto 0; list-style: none; }
  .older > summary::-webkit-details-marker { display: none; }
  .older[open] > summary { margin-bottom: 44px; }
  .older .when-open, .older[open] .when-closed { display: none; }
  .older[open] .when-open { display: inline; }

  @media (max-width: 760px) {
    .changelog-head { padding-block: 32px 28px; }
    .changelog-release { grid-template-columns: minmax(0, 1fr); gap: 14px; padding-bottom: 32px; }
    .changelog-release::before { display: none; }
    .release-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; }
    .release-dot { margin-top: 0; }
    .changelog-release h2 { font-size: 19px; }
    .changelog-release .badge { margin-top: 0; }
    .release-card { padding: 18px; }
    .big-one { flex-direction: column; align-items: flex-start; gap: 6px; }
    .entry { grid-template-columns: auto minmax(0, 1fr); }
    .entry .kind { min-width: 48px; padding-inline: 8px; }
    .entry .pr { grid-column: 2; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .changelog-release.latest .release-dot { animation: release-pulse 2.4s infinite; }
  }
  @keyframes release-pulse {
    0%, 100% { box-shadow: 0 0 0 3px var(--bg), 0 0 0 3px rgb(229 53 43 / 0.45); }
    70% { box-shadow: 0 0 0 3px var(--bg), 0 0 0 13px rgb(229 53 43 / 0); }
  }
</style>
