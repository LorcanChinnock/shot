---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Loop from '../components/Loop.astro';
import Window from '../components/Window.astro';
import Copy from '../components/Copy.astro';
import ForMacs from '../components/ForMacs.astro';
import HeroStage from '../components/HeroStage.astro';
import Arrow from '../components/Arrow.astro';
import { latestRelease } from '../lib/release';
import editor from '../../../docs/media/editor.png';
import captureArea from '../../../docs/media/capture-area.png';
import captureWindow from '../../../docs/media/capture-window.png';
import captureScroll from '../../../docs/media/capture-scroll.png';
import recordingSetup from '../../../docs/media/recording-setup.png';
import videoEditor from '../../../docs/media/video-editor.png';
import gallery from '../../../docs/media/gallery.png';

const release = await latestRelease();
const install = 'curl -fsSL https://shot.lorcanchinnock.com/install.sh | bash';

// Icon paths for the scrolling band and the capture tabs, drawn on a 24 px grid.
const icon = {
  area: 'M3 8V3h5M16 3h5v5M21 16v5h-5M8 21H3v-5',
  window: 'M3 5h18v14H3zM3 9h18',
  scroll: 'M12 3v14M7 12l5 5 5-5M5 21h14',
  arrow: 'M5 19L19 5M9 5h10v10',
  blur: 'M12 3s7 7 7 12a7 7 0 0 1-14 0c0-5 7-12 7-12z',
  mic: 'M9 3h6v11H9zM5 11a7 7 0 0 0 14 0M12 18v3',
  gif: 'M4 4h16v16H4zM9 9v6M13 9h3M13 12h2M13 9v6',
  search: 'M10 3a7 7 0 1 0 0 14a7 7 0 1 0 0-14M21 21l-6-6',
};

// What Shot does, on the dark band under the hero. Each icon takes one of the light colours.
const band: [string, string, string][] = [
  ['Area, window or page', icon.area, 'var(--accent)'],
  ['Long pages', icon.scroll, 'var(--tag-editor)'],
  ['Arrows and notes', icon.arrow, '#ff8a80'],
  ['Blur private details', icon.blur, 'var(--tag-editor)'],
  ['Record with your voice', icon.mic, '#ff8a80'],
  ['Export GIFs', icon.gif, 'var(--accent)'],
  ['Searchable library', icon.search, 'var(--tag-gallery)'],
];

// The Capture tabs. Each mode's panel holds its real still (cropped closer to the window, in the still's pixels), what it does and its keys (Keyboard shortcuts › While selecting).
const modes = [
  {
    id: 'area', label: 'Area', icon: icon.area, image: captureArea, crop: '--iw: 2000; --x: 340; --y: 200; --w: 1320; --h: 1035',
    alt: 'An area being dragged over a support ticket, around the customer\'s message and the order, with handles on its corners and edges',
    title: 'Drag out exactly what matters.',
    body: 'The screen freezes while you choose, so nothing moves under you. Hold ⇧ for a square, or press R to step through common ratios.',
    keys: [['⇧', 'Square'], ['R', 'Ratio'], ['Space', 'Move']],
  },
  {
    id: 'window', label: 'Window', icon: icon.window, image: captureWindow, crop: '--iw: 2000; --x: 340; --y: 200; --w: 1320; --h: 1035',
    alt: 'Window mode: a revenue dashboard window lit up in yellow, with its name and size in the middle, and the capture bar below with Window picked',
    title: 'Click a window to capture just that window.',
    body: 'Shot captures it as it is, even if something covers it, and keeps its macOS shadow. Press D for a delay when you need to open a menu first.',
    keys: [['Tab', 'Switch'], ['D', 'Delay'], ['↩', 'Capture']],
  },
  {
    id: 'scroll', label: 'Long page', icon: icon.scroll, image: captureScroll, crop: '--iw: 2000; --x: 0; --y: 0; --w: 2000; --h: 985',
    alt: 'A long help page being captured as it scrolls, beside a Keep scrolling panel that shows the image so far, with the part not captured yet hatched',
    title: 'Scroll a long page into one tall image.',
    body: 'Press S, then scroll the page yourself, in any direction. A sticky header appears only once, and the preview hatches what you haven\'t covered yet.',
    keys: [['S', 'Scroll'], ['↩', 'Done'], ['Esc', 'Cancel']],
  },
];

// The Mark up cards, each with its tool's key (Annotate a screenshot › Tools).
const tools = [
  { id: 'arrow', name: 'Arrows', key: 'A', body: 'Straight or bent, in any colour.', tilt: '-1.2deg' },
  { id: 'blur', name: 'Blur and pixelate', key: 'B', body: 'Hide emails, names and card numbers.', tilt: '1deg' },
  { id: 'highlight', name: 'Highlight', key: 'M', body: 'Draw the eye to one line.', tilt: '0.8deg' },
  { id: 'spot', name: 'Spotlight', key: 'F', body: 'Dim or blur everything else.', tilt: '-0.8deg' },
  { id: 'count', name: 'Numbered steps', key: 'N', body: 'Circles that count up for you.', tilt: '-1deg' },
  { id: 'note', name: 'Sticky notes', key: 'S', body: 'Say it right next to the problem.', tilt: '1.2deg' },
];

const promises: [string, string][] = [
  ['Nothing leaves your Mac', 'Captures are files in a folder you choose. Shot never uploads them or makes share links.'],
  ['Shared images stay clean', 'A saved copy never carries hidden layers or the full-size images you placed in it.'],
  ['Updates only when you agree', 'The one time Shot goes online is to check for a new version, and it asks you first.'],
];

const software = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Shot',
  description: 'A screenshot, annotation and screen recording app for the Mac menu bar, with a GIF exporter. Free and open source.',
  url: 'https://shot.lorcanchinnock.com/',
  image: 'https://shot.lorcanchinnock.com/icon-256.png',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'macOS 15 or later',
  softwareVersion: release.version,
  downloadUrl: 'https://github.com/LorcanChinnock/shot/releases/latest',
  license: 'https://github.com/LorcanChinnock/shot/blob/main/LICENSE',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Person', name: 'Lorcan Chinnock', url: 'https://lorcanchinnock.com' },
  sameAs: ['https://github.com/LorcanChinnock/shot'],
};
---

<Base>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(software)} />

  <section class="hero">
    <div class="wrap hero-head">
      <h1>A <span class="hl">better</span><br />
        <span class="hero-keys anchor"><kbd class="key big press">⌘</kbd><kbd class="key big accent press">⇧</kbd><kbd class="key big press">4</kbd></span>
      </h1>
      <p class="lede pop">Shot is a menu bar screenshot app that works with the shortcut you already use, and every capture is ready to paste.</p>
      <div class="hero-install pop">
        <p>To install Shot, paste this into Terminal:</p>
        <Copy command={install} />
        <p class="pill"><span class="badge dark">Free</span>Open source · No account · macOS 15 or later · Apple Silicon and Intel</p>
      </div>
      <ForMacs />
      <p class="meta">Version {release.version}</p>
    </div>
    <div class="wrap scene-wrap">
      <HeroStage />
    </div>
  </section>

  <div class="band-wrap">
    <div class="marquee band">
      {[0, 1].map((copy) => (
        <ul aria-label={copy ? undefined : 'What Shot does'} aria-hidden={copy ? 'true' : undefined}>
          {band.map(([label, d, colour]) => (
            <li><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" style={`--icon: ${colour}`}><path d={d} /></svg>{label}</li>
          ))}
        </ul>
      ))}
    </div>
  </div>

  <section id="features" class="reveal">
    <div class="wrap">
      <div class="head-row">
        <div class="section-head">
          <p class="step"><span class="counter">1</span>Capture</p>
          <h2>One shortcut for every kind of <span class="hl">capture</span>.</h2>
        </div>
        <p class="aside">Press <kbd class="key">⌘</kbd><kbd class="key">⇧</kbd><kbd class="key">4</kbd> then <kbd class="key">Tab</kbd> to switch between an area, a window and the whole screen. Shot remembers the one you used last.</p>
      </div>

      <div class="capture">
        <div class="mode-row">
          <div class="tabs" role="radiogroup" aria-label="Capture modes">
            {modes.map((m, i) => (
              <label><input type="radio" name="capture-mode" value={m.id} checked={i === 0} /><svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true"><path d={m.icon} /></svg>{m.label}</label>
            ))}
          </div>
          <span class="try deco" aria-hidden="true"><Arrow from={[52, 18]} to={[0, 10]} bend={0.12} head={14} /><span class="note">try them</span></span>
        </div>
        <div class="modes">
          {modes.map((m) => (
            <div class:list={['mode', m.id]}>
              <Window tone="lilac" tilt="-1deg">
                <div class="crop" style={m.crop}>
                  <Image src={m.image} alt={m.alt} widths={[1000, 2000]} sizes="(min-width: 1240px) 1000px, 100vw" />
                </div>
              </Window>
              <div class="mode-text">
                <h3>{m.title}</h3>
                <p>{m.body}</p>
                <ul class="keys">
                  {m.keys.map(([k, label]) => <li><kbd class="key">{k}</kbd>{label}</li>)}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="extras">
        <article class="ink-card extra tilt" style="--tilt: -0.6deg">
          <div class="extra-art panel lilac">
            <div class="crop" style="--iw: 2000; --x: 1508; --y: 40; --w: 446; --h: 654">
              <Image src={captureScroll} alt="The Keep scrolling panel during a long capture: a preview of the tall image so far, with the part not captured yet hatched, a size of 1,920 by 1,800, and the sticky header kept once" widths={[400, 900]} sizes="240px" />
            </div>
          </div>
          <div class="extra-text">
            <h3>Scroll a whole page into one image <kbd class="key">S</kbd></h3>
            <p>Press S, then scroll at your own pace in any app. Shot builds one tall picture as you go, up to 30,000 pixels long, and shows a sticky header only once.</p>
          </div>
        </article>
        <article class="ink-card extra tilt" style="--tilt: 0.6deg">
          <div class="extra-art panel sky">
            <div class="browser" role="img" aria-label="A browser window whose tabs and address bar are greyed out, with only the page below them outlined in yellow and labelled Captured">
              <div class="chrome" aria-hidden="true"><span class="dots"><i></i><i></i><i></i></span><span class="tab">Help centre</span><span class="url">acme.example/help</span></div>
              <div class="page" aria-hidden="true"><b>Help centre</b><i></i><i></i><i></i><i></i><span class="captured">Captured</span></div>
            </div>
          </div>
          <div class="extra-text">
            <h3>Just the page, without the browser <kbd class="key">B</kbd></h3>
            <p>Click a Safari, Chrome or Edge window and Shot captures the web page alone, with no tabs or address bar. Turn it on in Settings › Capture, or press B for one capture.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="reveal">
    <div class="wrap">
      <div class="section-head">
        <p class="step"><span class="counter">2</span>Mark up</p>
        <h2>Make the point before the moment <span class="hl">passes</span>.</h2>
      </div>
      <div class="markup">
        <div class="editor-card panel sky">
          <div class="editor-text">
            <h3>An editor that opens in a blink</h3>
            <p>Hover the corner card and click the pencil. Your marks stay editable, even after you save.</p>
          </div>
          <div class="editor-shot anchor tilt" style="--tilt: 1deg">
            <div class="crop" style="--iw: 1600; --x: 470; --y: 39; --w: 910; --h: 696">
              <Image src={editor} alt="Close up of the editor: the highlighted discount line on a support ticket, with a red arrow pointing at it from a sticky note, under the toolbar with Share, Save and Copy" widths={[600, 1200]} sizes="(min-width: 1240px) 760px, 100vw" />
            </div>
            <span class="editable deco" aria-hidden="true"><Arrow placed from={[44, -42]} to={[2, -4]} bend={-0.2} /><span class="note wobble">this arrow stays editable</span></span>
          </div>
        </div>
        <ul class="tools">
          {tools.map((t) => (
            <li class="ink-card tilt" style={`--tilt: ${t.tilt}`}>
              <div class:list={['demo', `d-${t.id}`]} aria-hidden="true">
                {t.id === 'arrow' && <Arrow placed from={[18, 50]} to={[118, 14]} bend={-0.15} />}
                {t.id === 'blur' && <span class="blurred">jane@example.com</span>}
                {t.id === 'highlight' && <span class="marker">Discount −$0.00</span>}
                {t.id === 'spot' && <span class="spot"><i /><i /><i /><span class="hole" /></span>}
                {t.id === 'count' && <span class="counts"><span class="counter">1</span><span class="counter">2</span><span class="counter">3</span></span>}
                {t.id === 'note' && <span class="mini-note">Total didn’t change</span>}
              </div>
              <h3>{t.name} <kbd class="key">{t.key}</kbd></h3>
              <p>{t.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="reveal">
    <div class="wrap">
      <div class="head-row">
        <div class="section-head">
          <p class="step"><span class="counter">3</span>Record</p>
          <h2>Record a walkthrough, then send it as a <span class="hl">GIF</span>.</h2>
        </div>
        <p class="aside"><kbd class="key">⌘</kbd><kbd class="key">⇧</kbd><kbd class="key">5</kbd> records an area, a window or the whole screen, with your voice, your Mac’s sound and your camera if you want them.</p>
      </div>
      <ol class="stages panel blush">
        <li class="card tilt" style="--tilt: -1.2deg">
          <div class="stage-shot"><Image src={recordingSetup} alt="The recording setup bar under a picked area, with buttons for the camera, the microphone, the cursor and a delay" widths={[400, 800]} sizes="(min-width: 1000px) 380px, 100vw" /><span class="counter" aria-hidden="true">1</span></div>
          <h3>Check it before you start</h3>
          <p>Hold <kbd class="key">⌥</kbd> as you pick to adjust the frame and turn the camera, microphone and cursor on or off.</p>
        </li>
        <li class="card tilt" style="--tilt: 0.8deg">
          <div class="stage-shot"><Loop name="recording" label="Stepping the Delay chip through its choices, picking an area to record, then the red recording outline around a chart, with the timer, Pause and Stop controls" /><span class="counter" aria-hidden="true">2</span></div>
          <h3>Talk it through</h3>
          <p>Pause whenever you need to. The red outline shows what’s being recorded, and it never ends up in the video.</p>
        </li>
        <li class="card tilt" style="--tilt: -0.6deg">
          <div class="stage-shot"><Image src={videoEditor} alt="The video editor with a 4-second cut in the timeline, a Best day label and an arrow over a revenue chart, and the GIF export options" widths={[400, 800]} sizes="(min-width: 1000px) 380px, 100vw" /><span class="counter" aria-hidden="true">3</span></div>
          <h3>Cut the dead air</h3>
          <p>Trim, cut and speed it up, draw over it, then export an MP4 or a GIF and see its size before you save.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="reveal">
    <div class="wrap find">
      <div class="find-text">
        <p class="step"><span class="counter">4</span>Find</p>
        <h2>Search what’s <span class="hl">inside</span> your screenshots.</h2>
        <p>Every capture lands in one library. Search the text in them, sort them into folders or tags, and drag any of them back out into another app.</p>
        <a class="go" href="/docs/find-your-captures/">Find your captures</a>
      </div>
      <Window tone="sage" tilt="1deg" class="find-shot">
        <div class="crop" style="--iw: 1600; --x: 170; --y: 88; --w: 1260; --h: 786">
          <Image src={gallery} alt="The gallery window with SPRING20 typed in its search field, showing the two screenshots of the ticket that mention it" widths={[700, 1400]} sizes="(min-width: 1240px) 700px, 100vw" />
        </div>
        <span slot="marks" class="search-label deco pop on-view" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24"><path d={icon.search} /></svg>SPRING20<span class="found">2 found</span></span>
      </Window>
    </div>
  </section>

  <section class="reveal">
    <div class="wrap">
      <div class="privacy dark-band">
        <div class="privacy-text">
          <h2>Your screen stays on your <span class="mac">Mac</span>.</h2>
          <p>Screenshots often hold things nobody else should see, so Shot has no account, uploads nothing and collects no analytics. The <a href="https://github.com/LorcanChinnock/shot">code is on GitHub</a> for anyone to check.</p>
          <span class="blur-chip" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24"><path d={icon.blur} /></svg><b>jane.doe@example.com</b><span>hidden with the Redact tool</span></span>
        </div>
        <ul class="promises">
          {promises.map(([title, body]) => (
            <li><span class="tick" aria-hidden="true"></span><span><b>{title}</b>{body}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="faq" class="reveal">
    <div class="narrow faq-list">
      <h2>Questions, <span class="hl">answered</span>.</h2>
      <details class="faq">
        <summary>Is Shot really free?</summary>
        <p>Yes. It’s free and open source under the GPL-3.0 license, with no ads and no paid tier. If it saves you time, you can <a href="/sponsor">sponsor it</a>.</p>
      </details>
      <details class="faq">
        <summary>Does it replace my Mac’s screenshot keys?</summary>
        <p>While Shot runs, <kbd class="key">⌘</kbd><kbd class="key">⇧</kbd><kbd class="key">4</kbd> and <kbd class="key">⌘</kbd><kbd class="key">⇧</kbd><kbd class="key">5</kbd> open Shot, and macOS gets them back when Shot quits. To keep the built-in tool, turn off Use Shot for ⌘⇧4 and ⌘⇧5 in Settings › Shortcuts, and Shot uses <kbd class="key">⌃</kbd><kbd class="key">⇧</kbd><kbd class="key">4</kbd> and <kbd class="key">⌃</kbd><kbd class="key">⇧</kbd><kbd class="key">5</kbd> instead.</p>
      </details>
      <details class="faq">
        <summary>Does anything get uploaded?</summary>
        <p>No. Shot has no account and no analytics, and your captures stay in a folder on your Mac. It only goes online to check for updates, and it asks you first. The <a href="/privacy/">privacy page</a> has the details.</p>
      </details>
      <details class="faq">
        <summary>What do I need?</summary>
        <p>A Mac with macOS 15 or later, on Apple Silicon or Intel.</p>
      </details>
      <details class="faq">
        <summary>Why does macOS warn me when I open it?</summary>
        <p>Apple hasn’t notarized Shot. The install command avoids the warning, but a zip downloaded in a browser shows it the first time, and <a href="/docs/get-started/">Get started</a> walks you through it.</p>
      </details>
      <details class="faq">
        <summary>How do I remove it?</summary>
        <p>One Terminal command removes Shot and everything it keeps. <a href="/docs/removing-shot/">Removing Shot</a> has the command, and the steps to do it by hand.</p>
      </details>
    </div>
  </section>

  <section class="install-section reveal" id="install">
    <div class="wrap">
      <div class="install">
        <h2>Press <span class="cta-keys anchor"><kbd class="key big press">⌘</kbd><kbd class="key big press">⇧</kbd><kbd class="key big press">4</kbd></span>.</h2>
        <p>Paste this into Terminal. It downloads the latest release, checks it against the release’s checksum and copies Shot into Applications.</p>
        <Copy command={install} />
        <ForMacs />
        <p class="small">Then click Grant in Shot’s welcome window and turn Shot on under Screen &amp; System Audio Recording. <a href="/docs/get-started/">Get started</a> covers the rest, and you can also <a href="https://github.com/LorcanChinnock/shot/releases/latest">download the zip from GitHub</a>.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero { padding: clamp(36px, 6vw, 64px) 0 0; }
  .hero-head { display: flex; flex-direction: column; align-items: center; gap: 26px; text-align: center; }
  .pill {
    display: inline-flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 4px 8px; margin: 4px 0 0;
    padding: 5px 12px 5px 6px; border-radius: 20px;
    font-size: 13.5px; color: var(--muted);
    background: var(--surface); box-shadow: 0 0 0 1px var(--edge), var(--soft-shadow);
  }
  /* Hero H1 (spec › Website values): the board's size, on the landing hero only. */
  .hero h1 { font-size: clamp(52px, 8.5vw, 112px); line-height: 0.98; letter-spacing: -0.045em; max-width: 1000px; }
  .hero h1 .hl { --delay: 500ms; }
  .hero-keys {
    display: inline-flex; gap: 0.12em; margin-top: 0.12em;
    /* The keys are drawn at heading size, so the ink scales with them. */
    --ink-ring: 0 0 0 3px var(--line);
    --ink-drop: 0 0.09em 0 var(--line);
  }
  .hero-keys kbd, .cta-keys kbd { font: inherit; font-size: 0.78em; font-weight: 800; min-width: 1.1em; padding: 0.02em 0.18em; border-radius: 0.18em; line-height: 1.2; margin: 0; }
  .hero-keys kbd:nth-of-type(1) { rotate: -4deg; }
  .hero-keys kbd:nth-of-type(2) { rotate: 2deg; --delay: 120ms; }
  .hero-keys kbd:nth-of-type(3) { rotate: -1deg; --delay: 240ms; }
  .lede { margin: 0; max-width: 600px; font-size: 21px; color: var(--muted); --delay: 300ms; }
  .hero-install { display: flex; flex-direction: column; align-items: center; gap: 10px; width: min(100%, 640px); --delay: 450ms; }
  .hero-install > p:first-child { margin: 0; font-size: 15px; color: var(--muted); }
  .hero-install :global(.copy) { width: 100%; text-align: left; }
  .meta { margin: 0; font-size: 13px; color: var(--tertiary); }
  .scene-wrap { margin-top: 52px; }
  @media (prefers-reduced-motion: no-preference) {
    .scene-wrap { animation: rise 1s 500ms var(--ease-out) both; }
  }

  /* ---------- The scrolling band ---------- */
  /* The band is tilted and wider than the page, so its wrapper clips its overhanging ends, sideways only, so its shadow
     and tilted edges still show. The wrapper is pulled up by the tilt's rise across the sand panel (half of at most
     1120px, at tan(1.6deg)), so the band's top meets the panel's lower-left corner and covers the strip under the capture
     bar on the right: no gap at any width. The band paints over the hero. Its left end drops about 1.4vw, so the margin
     below makes room for that. */
  .band-wrap {
    position: relative; overflow-x: clip; overflow-y: visible;
    margin-block: calc(-1 * min(16px, 1.4vw)) calc(1.4vw + 8px);
  }
  .band { margin-inline: -40px; padding: 18px 0; border-radius: 0; rotate: -1.6deg; transform: none; box-shadow: 0 10px 30px rgb(22 22 26 / 0.2); }
  .band li { display: flex; align-items: center; gap: 10px; padding-right: 44px; font-size: 17px; font-weight: 700; }
  .band svg { fill: none; stroke: var(--icon); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }

  /* The board's rhythm: more room above each section than below it. */
  section:not(.hero) { padding-block: clamp(56px, 8vw, 120px) clamp(24px, 3vw, 40px); }

  /* ---------- Section heads ---------- */
  .step { display: flex; align-items: center; gap: 9px; margin: 0; font-size: 14px; font-weight: 800; }
  .step .counter { width: 30px; height: 30px; font-size: 15px; box-shadow: 0 0 0 2.5px #fff, 0 4px 10px rgb(0 0 0 / 0.15); }
  /* The aside is the section's intro: straight under its heading, so it reads with it rather than floating at the far side. */
