---
import GuideSearch from '../../components/GuideSearch.astro';
import Prose from '../../layouts/Prose.astro';
import { groups, pages } from '../../lib/guide';

const [start] = pages;
const sections = groups
  .map((g) => ({ ...g, pages: pages.filter((p) => p.group === g.name && p !== start) }))
  .filter((g) => g.pages.length > 0);
---

<Prose title="User guide" description="How to use Shot: screenshots, recordings, the editors, AI agents, shortcuts and settings.">
  <div class="guide-home">
    <h1>How can we help?</h1>
    <p class="lede">Everything Shot can do, one task at a time. Search for what you need, or start at the top.</p>
    <GuideSearch />

    <a class="start card" href={`/docs/${start.slug}/`}>
      <span class="chip" style="--chip: var(--pink)">New to Shot?</span>
      <strong>{start.title} →</strong>
      <span>{start.summary}</span>
    </a>

    {sections.map((section) => (
      <section style={`--accent: var(--${section.color})`}>
        <h2>{section.name}</h2>
        <ul>
          {section.pages.map((page) => (
            <li>
              <a class="card" href={`/docs/${page.slug}/`}>
                <strong>{page.title}</strong>
                <span>{page.summary}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Prose>

<style>
  .guide-home h1 { margin-bottom: 12px; }
  .lede { margin: 0 0 24px; font-size: 20px; line-height: 1.45; color: var(--muted); }
  .guide-home :global(.guide-search) { margin-bottom: 28px; }
  .start { display: grid; gap: 6px; justify-items: start; padding: 20px 22px; text-decoration: none; background: var(--yellow); color: var(--on-accent); }
  .start strong { font: 900 26px/1.1 var(--display); letter-spacing: -0.02em; }
  .start span:last-child { font-size: 17px; }
  section { padding: 0; margin-top: 36px; }
  .guide-home section h2 { display: flex; align-items: center; gap: 10px; margin: 0 0 14px; padding: 0; border: 0; font-size: 22px; }
  h2::before { content: ""; flex: none; width: 14px; height: 14px; border: var(--border) solid var(--line); border-radius: 50%; background: var(--accent); }
  ul { list-style: none; margin: 0; padding: 0 !important; display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }
  li { margin: 0 !important; display: grid; }
  ul .card { display: grid; align-content: start; gap: 4px; padding: 14px 16px; text-decoration: none; background: var(--paper); border-top-width: 8px; border-top-color: var(--accent); }
  ul .card strong { font-size: 18px; font-weight: 900; }
  ul .card span { font-size: 15px; line-height: 1.45; font-weight: 500; color: var(--muted); }
</style>
