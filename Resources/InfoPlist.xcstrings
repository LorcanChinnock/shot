    "NSCameraUsageDescription" : {
      "comment" : "Asked the first time a recording turns the camera on.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot zeigt deine Kamera bei Bildschirmaufzeichnungen in einer Blase, wenn du sie einschaltest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot shows your camera in a bubble during screen recordings when you turn it on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot muestra tu cámara en una burbuja durante las grabaciones de pantalla cuando la activas."
