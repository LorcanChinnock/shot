    "Off gives macOS its screenshot keys back, and Shot’s default shortcuts become ⌃⇧4 and ⌃⇧5." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus gibt macOS seine Bildschirmfoto-Tasten zurück, und Shots Standardkurzbefehle werden zu ⌃⇧4 und ⌃⇧5."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado devuelve a macOS sus teclas de captura, y los atajos predeterminados de Shot pasan a ser ⌃⇧4 y ⌃⇧5."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé rend à macOS ses touches de capture d’écran, et les raccourcis par défaut de Shot deviennent ⌃⇧4 et ⌃⇧5."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se disattivato, macOS riprende i suoi tasti per le istantanee e le abbreviazioni predefinite di Shot diventano ⌃⇧4 e ⌃⇧5."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにすると macOS にスクリーンショットのキーが戻り、Shot のデフォルトのショートカットは ⌃⇧4 と ⌃⇧5 になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끄면 macOS가 스크린샷 키를 다시 쓰고, Shot의 기본 단축키는 ⌃⇧4와 ⌃⇧5가 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado devolve ao macOS suas teclas de captura de tela, e os atalhos padrão do Shot passam a ser ⌃⇧4 e ⌃⇧5."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭后 macOS 会收回截屏按键，Shot 的默认快捷键变为 ⌃⇧4 和 ⌃⇧5。"
          }
        }
      }
    },
    "Off keeps the original and saves a copy." : {
