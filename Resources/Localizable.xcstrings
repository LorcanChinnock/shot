    "The timer waits while the pointer is on the card, and starts again when it leaves." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Timer wartet, solange der Zeiger auf der Karte ist, und beginnt von vorn, wenn er sie verlässt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El temporizador espera mientras el puntero está sobre la tarjeta y vuelve a empezar cuando sale."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le minuteur attend tant que le pointeur est sur la carte, et repart quand il la quitte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il timer attende finché il puntatore è sulla scheda e riparte quando la lascia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポインタがカード上にある間はタイマーが止まり、離れると最初から始まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포인터가 카드 위에 있는 동안 타이머가 멈추고, 벗어나면 다시 시작합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cronômetro espera enquanto o ponteiro está sobre o cartão e recomeça quando ele sai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指针停在卡片上时计时器会等待，移开后重新开始。"
          }
        }
      }
    },
    "The updater didn’t start. Install the latest Shot from the website to get updates again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Update-Funktion ist nicht gestartet. Installiere das neueste Shot von der Website, um wieder Updates zu bekommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El actualizador no se inició. Instala el Shot más reciente desde el sitio web para volver a recibir actualizaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le système de mise à jour n’a pas démarré. Installez le dernier Shot depuis le site web pour recevoir à nouveau les mises à jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il programma di aggiornamento non si è avviato. Installa l’ultimo Shot dal sito web per ricevere di nuovo gli aggiornamenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップデート機能を開始できませんでした。Web サイトから最新の Shot をインストールすると、再びアップデートを受け取れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업데이트 기능이 시작되지 않았습니다. 웹사이트에서 최신 Shot을 설치하면 다시 업데이트를 받을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
