    "This window was captured with its own shadow, so it takes no other shadow, border or corners" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Fenster wurde mit eigenem Schatten aufgenommen und erhält daher keinen anderen Schatten, Rahmen oder Ecken"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta ventana se capturó con su propia sombra, así que no admite otra sombra, borde ni esquinas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette fenêtre a été capturée avec sa propre ombre : elle ne prend pas d’autre ombre, bordure ni coins"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa finestra è stata catturata con la sua ombra, quindi non accetta altre ombre, bordi o angoli"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このウインドウは独自の影付きでキャプチャされたため、ほかの影、枠線、角は付けられません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 윈도우는 자체 그림자와 함께 캡처되어 다른 그림자, 테두리, 모서리를 적용할 수 없습니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta janela foi capturada com a própria sombra, então não aceita outra sombra, borda ou cantos"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
