    "Drag captures onto this folder in the sidebar, or use Move to in a capture's menu. Captures in the folders inside it show when you open them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh Aufnahmen in der Seitenleiste auf diesen Ordner oder verwende „Verschieben nach“ im Menü einer Aufnahme. Aufnahmen in den Ordnern darin erscheinen, wenn du sie öffnest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra capturas a esta carpeta en la barra lateral o usa Mover a en el menú de una captura. Las capturas de las carpetas que contiene aparecen al abrirlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser des captures sur ce dossier dans la barre latérale, ou utilisez Déplacer vers dans le menu d’une capture. Les captures des dossiers qu’il contient s’affichent quand vous les ouvrez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina le catture su questa cartella nella barra laterale o usa Sposta in nel menu di una cattura. Le catture nelle cartelle al suo interno compaiono quando le apri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイドバーのこのフォルダにキャプチャをドラッグするか、キャプチャのメニューの「移動」を使います。中のフォルダにあるキャプチャは、そのフォルダを開くと表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사이드바의 이 폴더로 캡처를 드래그하거나 캡처 메뉴의 ‘이동’을 사용하세요. 안에 있는 폴더의 캡처는 그 폴더를 열면 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste capturas para esta pasta na barra lateral ou use Mover para no menu de uma captura. As capturas das pastas dentro dela aparecem quando você as abre."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将捕捉拖到边栏中的此文件夹上，或使用捕捉菜单中的“移到”。其子文件夹中的捕捉会在你打开子文件夹时显示。"
          }
        }
      }
    },
