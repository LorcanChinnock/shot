          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun pour l’instant. Shot garde l’original d’une capture quand Enregistrer la remplace, pour que vous puissiez annuler."
          }
        },
        "it" : {
          "stringUnit" : {
