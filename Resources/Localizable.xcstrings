        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona un clip para moverlo, escalarlo, girarlo o fundirlo, y para animarlo con fotogramas clave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
