    "Shot can now find the page in a browser window. Turn on Capture only the page in browser windows in Settings to use it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot kann jetzt die Seite in einem Browserfenster finden. Aktiviere dazu „In Browserfenstern nur die Seite aufnehmen“ in den Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot ya puede encontrar la página en una ventana del navegador. Activa Capturar solo la página en ventanas del navegador en Ajustes para usarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot peut maintenant trouver la page dans une fenêtre de navigateur. Pour l’utiliser, activez « Capturer uniquement la page dans les fenêtres de navigateur » dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora Shot può trovare la pagina in una finestra del browser. Attiva Cattura solo la pagina nelle finestre del browser nelle Impostazioni per usarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotがブラウザウインドウ内のページを見つけられるようになりました。使うには、設定で「ブラウザウインドウではページだけをキャプチャ」をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 Shot이 브라우저 창에서 페이지를 찾을 수 있습니다. 사용하려면 설정에서 ‘브라우저 창에서는 페이지만 캡처’를 켜세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Shot agora encontra a página em uma janela do navegador. Ative Capturar só a página em janelas do navegador nos Ajustes para usar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot 现在可以找到浏览器窗口中的页面。在设置中打开“在浏览器窗口中仅捕捉页面”即可使用。"
          }
        }
      }
    },
    "Shot can't use the camera. Turn it on in System Settings › Privacy & Security › Camera." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot kann die Kamera nicht verwenden. Aktiviere sie unter Systemeinstellungen › Datenschutz & Sicherheit › Kamera."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot no puede usar la cámara. Actívala en Ajustes del Sistema › Privacidad y seguridad › Cámara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot ne peut pas utiliser la caméra. Activez-la dans Réglages Système › Confidentialité et sécurité › Caméra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot non può usare la fotocamera. Attivala in Impostazioni di Sistema › Privacy e sicurezza › Fotocamera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotはカメラを使用できません。システム設定 › プライバシーとセキュリティ › カメラでオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot이 카메라를 사용할 수 없습니다. 시스템 설정 › 개인정보 보호 및 보안 › 카메라에서 켜세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Shot não pode usar a câmera. Ative-a em Ajustes do Sistema › Privacidade e Segurança › Câmera."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot 无法使用摄像头。请在“系统设置” › “隐私与安全性” › “摄像头”中开启。"
          }
        }
      }
    },
    "Shot can't use the microphone. Turn it on in System Settings › Privacy & Security › Microphone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot kann das Mikrofon nicht verwenden. Aktiviere es unter Systemeinstellungen › Datenschutz & Sicherheit › Mikrofon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot no puede usar el micrófono. Actívalo en Ajustes del Sistema › Privacidad y seguridad › Micrófono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot ne peut pas utiliser le micro. Activez-le dans Réglages Système › Confidentialité et sécurité › Microphone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot non può usare il microfono. Attivalo in Impostazioni di Sistema › Privacy e sicurezza › Microfono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotはマイクを使用できません。システム設定 › プライバシーとセキュリティ › マイクでオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot이 마이크를 사용할 수 없습니다. 시스템 설정 › 개인정보 보호 및 보안 › 마이크에서 켜세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Shot não pode usar o microfone. Ative-o em Ajustes do Sistema › Privacidade e Segurança › Microfone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot 无法使用麦克风。请在“系统设置” › “隐私与安全性” › “麦克风”中开启。"
          }
        }
      }
    },
    "Shot can’t check for updates" : {
      "localizations" : {
        "de" : {
