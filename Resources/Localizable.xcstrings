    "Fit the canvas to what's on it, trim it to the image, or choose its background in the Style panel." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe die Leinwand an ihren Inhalt an, beschneide sie auf das Bild oder wähle ihren Hintergrund im Stil-Bereich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta el lienzo a su contenido, recórtalo a la imagen o elige su fondo en el panel Estilo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustez le canevas à son contenu, rognez-le à l’image ou choisissez son fond dans le panneau Style."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adatta la tela al contenuto, ritagliala sull’immagine o scegli lo sfondo nel pannello Stile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャンバスを内容に合わせる、画像に合わせて切り詰める、または「スタイル」パネルで背景を選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캔버스를 내용에 맞추거나, 이미지에 맞게 자르거나, 스타일 패널에서 배경을 고릅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste a tela ao conteúdo, recorte-a na imagem ou escolha o fundo no painel Estilo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让画布适合内容、裁剪到图像，或在“样式”面板中选择背景。"
          }
        }
      }
    },
