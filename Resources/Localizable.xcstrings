    "Everything Shot saves to %@ appears here, and you can search the text inside it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, was Shot in %@ sichert, erscheint hier, und du kannst den Text darin durchsuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que Shot guarda en %@ aparece aquí, y puedes buscar el texto que contiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce que Shot enregistre dans %@ apparaît ici, et vous pouvez rechercher le texte qu’il contient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto ciò che Shot salva in %@ compare qui, e puoi cercare il testo al suo interno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot が %@ に保存したものはすべてここに表示され、その中のテキストを検索できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot이 %@에 저장하는 모든 항목이 여기에 표시되며, 그 안의 텍스트를 검색할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo o que o Shot salva em %@ aparece aqui, e você pode buscar o texto dentro dele."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot 存储到 %@ 的所有内容都会显示在这里，你还可以搜索其中的文字。"
          }
        }
      }
    },
