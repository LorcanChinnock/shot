    "Shortcut unavailable: %@. Another app may use it, so choose a different one in Settings › Shortcuts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurzbefehl nicht verfügbar: %@. Vielleicht nutzt eine andere App ihn. Wähle einen anderen unter Einstellungen › Kurzbefehle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atajo no disponible: %@. Puede que otra app lo use; elige otro en Ajustes › Atajos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raccourci indisponible : %@. Une autre app l'utilise peut-être, choisissez-en un autre dans Réglages › Raccourcis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbreviazione non disponibile: %@. Forse la usa un'altra app: scegline un'altra in Impostazioni › Abbreviazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカットを使用できません：%@。別のアプリが使用している可能性があります。設定 › ショートカットで別のものを選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축키를 사용할 수 없음: %@. 다른 앱에서 사용 중일 수 있으니 설정 › 단축키에서 다른 단축키를 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atalho indisponível: %@. Outro app pode estar usando, então escolha outro em Ajustes › Atalhos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快捷键不可用：%@。其他 App 可能正在使用，请在“设置” › “快捷键”中另选一个。"
          }
        }
      }
    },
