    "New captures open and copy with this screenshot's background, padding, size, shadow, border and corners." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Aufnahmen werden mit Hintergrund, Rand, Größe, Schatten, Rahmen und Ecken dieses Bildschirmfotos geöffnet und kopiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las nuevas capturas se abren y se copian con el fondo, el margen, el tamaño, la sombra, el borde y las esquinas de esta captura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouvelles captures s’ouvrent et se copient avec le fond, la marge, la taille, l’ombre, la bordure et les coins de cette capture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nuove catture si aprono e si copiano con sfondo, margine, dimensioni, ombra, bordo e angoli di questa schermata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいキャプチャは、このスクリーンショットの背景、余白、サイズ、影、枠線、角で開いてコピーされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 캡처는 이 스크린샷의 배경, 여백, 크기, 그림자, 테두리, 모서리로 열리고 복사됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novas capturas abrem e são copiadas com o fundo, a margem, o tamanho, a sombra, a borda e os cantos desta captura."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新的截图会以此截图的背景、边距、尺寸、阴影、边框和圆角打开并拷贝。"
          }
        }
      }
