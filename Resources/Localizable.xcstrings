    "Cuts out the selected section or clip and closes the gap. Shift-drag along the lanes to select a section." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schneidet den ausgewählten Abschnitt oder Clip heraus und schließt die Lücke. Ziehe mit gedrückter Umschalttaste über die Spuren, um einen Abschnitt auszuwählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corta la sección o el clip seleccionado y cierra el hueco. Arrastra con Mayúsculas por las pistas para seleccionar una sección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupe la section ou le clip sélectionné et referme l’espace. Faites glisser avec Maj le long des pistes pour sélectionner une section."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taglia la sezione o la clip selezionata e chiude il vuoto. Trascina con Maiusc lungo le tracce per selezionare una sezione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した区間またはクリップをカットし、間を詰めます。区間を選択するには、Shift キーを押しながらレーンに沿ってドラッグします。"
          }
        },
        "ko" : {
          "stringUnit" : {
