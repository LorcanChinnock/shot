    "Shot asks GitHub once a day whether a new version is out, and installs it when you agree. Nothing else is sent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot fragt einmal am Tag bei GitHub nach einer neuen Version und installiert sie, wenn du zustimmst. Sonst wird nichts gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot pregunta a GitHub una vez al día si hay una nueva versión y la instala cuando aceptas. No se envía nada más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot demande à GitHub une fois par jour si une nouvelle version est sortie, et l'installe avec votre accord. Rien d'autre n'est envoyé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot chiede a GitHub una volta al giorno se c'è una nuova versione e la installa quando accetti. Non viene inviato nient'altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotは1日に1回GitHubで新しいバージョンを確認し、同意するとインストールします。それ以外の情報は送信しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot은 하루에 한 번 GitHub에 새 버전이 있는지 확인하고, 동의하면 설치합니다. 그 밖에는 아무것도 전송하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Shot pergunta ao GitHub uma vez por dia se há uma nova versão e a instala se você concordar. Nada mais é enviado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot 每天向 GitHub 查询一次是否有新版本，并在你同意后安装。不会发送其他任何信息。"
          }
        }
      }
    },
    "Shot can now find the page in a browser window." : {},
    "Shot can't use the camera. Turn it on in System Settings › Privacy & Security › Camera." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot kann die Kamera nicht verwenden. Aktiviere sie unter Systemeinstellungen › Datenschutz & Sicherheit › Kamera."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot no puede usar la cámara. Actívala en Ajustes del Sistema › Privacidad y seguridad › Cámara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot ne peut pas utiliser la caméra. Activez-la dans Réglages Système › Confidentialité et sécurité › Caméra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot non può usare la fotocamera. Attivala in Impostazioni di Sistema › Privacy e sicurezza › Fotocamera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotはカメラを使用できません。システム設定 › プライバシーとセキュリティ › カメラでオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot이 카메라를 사용할 수 없습니다. 시스템 설정 › 개인정보 보호 및 보안 › 카메라에서 켜세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Shot não pode usar a câmera. Ative-a em Ajustes do Sistema › Privacidade e Segurança › Câmera."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot 无法使用摄像头。请在“系统设置” › “隐私与安全性” › “摄像头”中开启。"
          }
        }
      }
    },
    "Shot can't use the microphone. Turn it on in System Settings › Privacy & Security › Microphone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot kann das Mikrofon nicht verwenden. Aktiviere es unter Systemeinstellungen › Datenschutz & Sicherheit › Mikrofon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot no puede usar el micrófono. Actívalo en Ajustes del Sistema › Privacidad y seguridad › Micrófono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot ne peut pas utiliser le micro. Activez-le dans Réglages Système › Confidentialité et sécurité › Microphone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot non può usare il microfono. Attivalo in Impostazioni di Sistema › Privacy e sicurezza › Microfono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotはマイクを使用できません。システム設定 › プライバシーとセキュリティ › マイクでオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot이 마이크를 사용할 수 없습니다. 시스템 설정 › 개인정보 보호 및 보안 › 마이크에서 켜세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Shot não pode usar o microfone. Ative-o em Ajustes do Sistema › Privacidade e Segurança › Microfone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot 无法使用麦克风。请在“系统设置” › “隐私与安全性” › “麦克风”中开启。"
          }
        }
      }
    },
    "Shot comes with no warranty. It updates itself with Sparkle, under the MIT license." : {},
    "Shot is free, with no ads or account. Sponsoring keeps it that way." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot ist kostenlos, ohne Werbung und Konto. Sponsoring sorgt dafür, dass es so bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot es gratis, sin anuncios ni cuenta. Patrocinarlo ayuda a que siga así."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot est gratuit, sans publicité ni compte. Le sponsoring permet que ça dure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot è gratuito, senza pubblicità né account. Le sponsorizzazioni lo mantengono così."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotは無料で、広告もアカウントもありません。スポンサーになって、この状態を支えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot은 광고나 계정 없이 무료입니다. 후원이 이를 지켜 줍니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Shot é gratuito, sem anúncios nem conta. O patrocínio o mantém assim."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot 免费，没有广告，无需账户。赞助让它保持这样。"
          }
        }
      }
    },
