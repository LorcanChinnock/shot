    "Delete what was recorded. Undo brings it back for 5 seconds." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht das Aufgenommene. „Widerrufen“ holt es 5 Sekunden lang zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina lo grabado. Deshacer lo recupera durante 5 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime ce qui a été enregistré. Annuler le rétablit pendant 5 secondes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina ciò che è stato registrato. Annulla lo ripristina per 5 secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録画した内容を削除します。5 秒間は「取り消す」で元に戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녹화된 내용을 삭제합니다. 5초 동안은 실행 취소로 되돌릴 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga o que foi gravado. Desfazer traz de volta por 5 segundos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除已录制的内容。5 秒内可用“撤销”恢复。"
          }
        }
      }
    },
