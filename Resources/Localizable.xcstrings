    "Just for this recording. Settings › Recording sets the one each recording starts with." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur für diese Aufzeichnung. Unter Einstellungen › Aufzeichnung legst du fest, mit welcher jede Aufzeichnung beginnt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo para esta grabación. Ajustes › Grabación define con cuál empieza cada grabación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniquement pour cet enregistrement. Réglages › Enregistrement définit celle utilisée au début de chaque enregistrement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo per questa registrazione. Impostazioni › Registrazione sceglie quella con cui parte ogni registrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この収録だけに適用されます。各収録の初期値は 設定 › 収録 で設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 녹화에만 적용됩니다. 각 녹화의 기본값은 설정 › 녹화에서 정합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só para esta gravação. Ajustes › Gravando define a taxa com que cada gravação começa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅用于本次录制。“设置 › 正在录制”决定每次录制开始时使用的帧率。"
          }
        }
      }
    },
    "K keys every property at once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K setzt Keyframes für alle Eigenschaften auf einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K añade fotogramas clave a todas las propiedades a la vez."
          }
        },
        "fr" : {
