    "macOS's own screenshot shortcuts turn off while Shot runs, and come back when it quits." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die macOS-eigenen Bildschirmfoto-Kurzbefehle sind aus, solange Shot läuft, und kommen zurück, wenn es beendet wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las funciones rápidas de captura de pantalla de macOS se desactivan mientras Shot está abierto y vuelven cuando lo cierras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les raccourcis de capture d'écran de macOS sont désactivés tant que Shot est ouvert, et reviennent quand vous le quittez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le abbreviazioni screenshot di macOS si disattivano mentre Shot è in esecuzione e tornano quando Shot si chiude."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotの実行中はmacOS標準のスクリーンショットのショートカットがオフになり、終了すると元に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
