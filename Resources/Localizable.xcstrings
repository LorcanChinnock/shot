    "Shot downloads each new version by itself and installs it when Shot next quits." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot lädt jede neue Version selbst und installiert sie, wenn Shot das nächste Mal beendet wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot descarga cada versión nueva por sí solo y la instala la próxima vez que se cierre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot télécharge chaque nouvelle version tout seul et l’installe la prochaine fois qu’il quitte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot scarica da solo ogni nuova versione e la installa alla prossima chiusura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot は新しいバージョンを自動でダウンロードし、次に終了したときにインストールします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot이 새 버전을 직접 내려받고 다음에 종료할 때 설치합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Shot baixa cada nova versão sozinho e instala na próxima vez que fechar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot 会自动下载每个新版本，并在下次退出时安装。"
          }
        }
      }
    },
