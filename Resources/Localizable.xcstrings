    "Folders are made in %@, so they show in Finder too." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordner werden in %@ angelegt und erscheinen daher auch im Finder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las carpetas se crean en %@, así que también aparecen en el Finder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dossiers sont créés dans %@ et apparaissent donc aussi dans le Finder."
