    },
    "The quick path saves and copies each capture and shows it in Quick Access, without opening a window." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der schnelle Weg sichert und kopiert jede Aufnahme und zeigt sie im Schnellzugriff, ohne ein Fenster zu öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ruta rápida guarda y copia cada captura y la muestra en Acceso rápido, sin abrir ninguna ventana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chemin rapide enregistre et copie chaque capture et l’affiche dans Accès rapide, sans ouvrir de fenêtre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il percorso rapido salva e copia ogni cattura e la mostra in Accesso rapido, senza aprire finestre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クイックパスでは、キャプチャごとに保存とコピーを行い、ウインドウを開かずにクイックアクセスに表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빠른 경로는 캡처할 때마다 저장하고 복사한 뒤, 창을 열지 않고 빠른 접근에 표시합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O caminho rápido salva e copia cada captura e a mostra no Acesso Rápido, sem abrir nenhuma janela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快捷路径会保存并拷贝每次捕捉，并在快速访问中显示，不会打开窗口。"
          }
        }
      }
    },
    "The recording has no video track" : {
      "localizations" : {
