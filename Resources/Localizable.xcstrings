    " It's temporary: Shot deletes it after a day." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Die Datei ist temporär: Shot löscht sie nach einem Tag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Es temporal: Shot lo elimina al cabo de un día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Ce fichier est temporaire : Shot le supprime au bout d’un jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " È temporaneo: Shot lo elimina dopo un giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時ファイルのため、1日後にShotが削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 임시 파일이므로 하루 뒤 Shot이 삭제합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " É temporário: o Shot o apaga depois de um dia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是临时文件：Shot 会在一天后删除它。"
          }
        }
      }
    },
