        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle quitte aussi %@. Vous pouvez la remettre en place depuis la corbeille dans le Finder."
          }
        },
        "it" : {
          "stringUnit" : {
