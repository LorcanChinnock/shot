          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quitará de %lld capturas. Las capturas se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sera retiré de %lld captures. Les captures elles-mêmes restent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrà rimosso da %lld catture. Le catture restano."
          }
        },
        "ja" : {
