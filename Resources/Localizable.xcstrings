    "Adds video or sound files to the timeline, at the playhead or after the recording. You can also drop them on the window." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt Video- oder Tondateien zur Zeitleiste hinzu, an der Abspielposition oder nach der Aufnahme. Du kannst sie auch auf das Fenster ziehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade archivos de vídeo o sonido a la línea de tiempo, en el cursor de reproducción o después de la grabación. También puedes soltarlos en la ventana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute des fichiers vidéo ou son à la timeline, à la tête de lecture ou après l’enregistrement. Vous pouvez aussi les déposer sur la fenêtre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge file video o audio alla timeline, alla testina o dopo la registrazione. Puoi anche trascinarli sulla finestra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオやサウンドのファイルをタイムラインの再生位置、または収録の後ろに追加します。ウインドウにドロップしても追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비디오나 사운드 파일을 타임라인의 재생 위치나 녹화 뒤에 추가합니다. 윈도우에 끌어다 놓아도 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona arquivos de vídeo ou som à linha do tempo, no cursor de reprodução ou depois da gravação. Você também pode soltá-los na janela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将视频或声音文件添加到时间线的播放头处或录制内容之后。也可以将它们拖到窗口上。"
          }
        }
      }
    },
