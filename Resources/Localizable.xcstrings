    "Press %@, then drag out any area." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drück %@ und zieh einen Bereich auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa %@ y arrastra sobre cualquier área."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur %@, puis faites glisser sur la zone voulue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi %@, poi trascina su un'area qualsiasi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を押して、好きな範囲をドラッグします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 키를 누른 다음 원하는 영역을 드래그하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione %@ e arraste qualquer área."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按下 %@，然后拖出任意区域。"
          }
        }
      }
    },
    "Press Tab while you pick an area to choose a window or the full screen instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drück Tab, während du einen Bereich wählst, um stattdessen ein Fenster oder den ganzen Bildschirm zu wählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa Tab mientras eliges un área para elegir una ventana o la pantalla completa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur Tab pendant que vous choisissez une zone pour choisir plutôt une fenêtre ou tout l’écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi Tab mentre scegli un’area per scegliere invece una finestra o lo schermo intero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "範囲を選んでいるときにTabキーを押すと、代わりにウインドウや画面全体を選べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영역을 고르는 동안 Tab을 누르면 대신 윈도우나 전체 화면을 고를 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione Tab enquanto escolhe uma área para escolher uma janela ou a tela inteira."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选取区域时按 Tab 键，可改为选择窗口或全屏。"
          }
        }
      }
    },
