    "Copy the file's path for an AI assistant or a chat, save a copy somewhere else, show it in Finder or pin it to your screen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiere den Pfad der Datei für einen KI-Assistenten oder einen Chat, sichere eine Kopie an einem anderen Ort, zeige sie im Finder oder hefte sie an deinen Bildschirm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia la ruta del archivo para un asistente de IA o un chat, guarda una copia en otro sitio, muéstralo en el Finder o fíjalo en la pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiez le chemin du fichier pour un assistant IA ou une discussion, enregistrez une copie ailleurs, affichez-le dans le Finder ou épinglez-le à l'écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia il percorso del file per un assistente IA o una chat, salva una copia altrove, mostralo nel Finder o fissalo sullo schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI アシスタントやチャット用にファイルのパスをコピーしたり、別の場所にコピーを保存したり、Finder で表示したり、画面に固定したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 어시스턴트나 채팅용으로 파일 경로를 복사하거나, 다른 곳에 사본을 저장하거나, Finder에서 보거나, 화면에 고정할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie o caminho do arquivo para um assistente de IA ou um chat, salve uma cópia em outro lugar, mostre-o no Finder ou fixe-o na tela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
