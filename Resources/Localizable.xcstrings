        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "핸들을 드래그해 다듬습니다. Shift-드래그로 구간을 선택한 다음 Delete 키를 눌러 잘라냅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
