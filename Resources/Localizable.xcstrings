    "Puts the format, GIF size, mute and speed back to how new exports start." : {

    },
    "Puts the position, scale, turn and opacity back and clears the keyframes. The crop and style stay." : {

    },
    "Puts the screenshot's background, padding, size, shadow, border and corners back to how a new capture starts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt Hintergrund, Rand, Größe, Schatten, Rahmen und Ecken des Bildschirmfotos auf den Stand einer neuen Aufnahme zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devuelve el fondo, el margen, el tamaño, la sombra, el borde y las esquinas de la captura a como empieza una captura nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remet le fond, la marge, la taille, l’ombre, la bordure et les coins de la capture comme ceux d’une nouvelle capture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riporta sfondo, margine, dimensioni, ombra, bordo e angoli della schermata a come inizia una nuova cattura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンショットの背景、余白、サイズ、影、枠線、角を新しいキャプチャの状態に戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크린샷의 배경, 여백, 크기, 그림자, 테두리, 모서리를 새 캡처를 시작할 때의 상태로 되돌립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volta o fundo, a margem, o tamanho, a sombra, a borda e os cantos da captura ao início de uma nova captura."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将截图的背景、边距、尺寸、阴影、边框和圆角恢复为新截图的初始状态。"
          }
        }
      }
    },
    "Puts the selection's shadow, border and corners back to how new ones start." : {
      "localizations" : {
