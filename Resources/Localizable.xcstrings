          "stringUnit" : {
            "state" : "translated",
            "value" : "„Sichern unter“ kann die Datei, die du bearbeitest, nicht ersetzen. Verwende „Sichern“ oder wähle einen anderen Namen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardar como no puede reemplazar el archivo que estás editando. Usa Guardar o elige otro nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrer sous ne peut pas remplacer le fichier que vous modifiez. Utilisez Enregistrer ou choisissez un autre nom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva come non può sostituire il file che stai modificando. Usa Salva o scegli un altro nome."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「別名で保存」では編集中のファイルを置き換えられません。「保存」を使うか、別の名前を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 이름으로 저장으로는 편집 중인 파일을 대치할 수 없습니다. 저장을 사용하거나 다른 이름을 고르세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvar como não pode substituir o arquivo que você está editando. Use Salvar ou escolha outro nome."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“存储为”无法替换你正在编辑的文件。请使用“存储”，或选取其他名称。"
          }
        }
      }
    },
