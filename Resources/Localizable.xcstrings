    "Your annotations are lost if you discard them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Markierungen gehen verloren, wenn du sie verwirfst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si las descartas, perderás tus anotaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos annotations seront perdues si vous ne les enregistrez pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se le scarti, le annotazioni andranno perse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "破棄すると注釈は失われます。"
