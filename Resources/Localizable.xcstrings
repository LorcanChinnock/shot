    "Add a shadow, border or rounded corners to the selected image, a shadow or glow to a shape, arrow or text, or style the screenshot when nothing is selected" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schatten, Rahmen oder runde Ecken für das ausgewählte Bild, Schatten oder Leuchten für Form, Pfeil oder Text – oder ohne Auswahl das Bildschirmfoto gestalten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una sombra, un borde o esquinas redondeadas a la imagen seleccionada, una sombra o un brillo a una forma, flecha o texto, o da estilo a la captura si no hay nada seleccionado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez une ombre, une bordure ou des coins arrondis à l'image sélectionnée, une ombre ou une lueur à une forme, une flèche ou un texte, ou stylisez la capture d'écran si rien n'est sélectionné"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi ombra, bordo o angoli arrotondati all'immagine selezionata, ombra o bagliore a forme, frecce o testo, oppure dai uno stile allo screenshot se non è selezionato nulla"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したイメージに影、枠線、角丸を、図形・矢印・テキストに影や光彩を追加します。何も選択していないときはスクリーンショットのスタイルを設定します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 이미지에 그림자, 테두리 또는 둥근 모서리를, 도형·화살표·텍스트에 그림자나 광채를 추가하거나, 선택한 항목이 없으면 스크린샷 스타일 지정"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione sombra, borda ou cantos arredondados à imagem selecionada, sombra ou brilho a uma forma, seta ou texto, ou estilize a captura de tela quando nada estiver selecionado"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为所选图像添加阴影、边框或圆角，为形状、箭头或文本添加阴影或光晕；未选择任何内容时则设置截屏的样式"
          }
        }
      }
    },
