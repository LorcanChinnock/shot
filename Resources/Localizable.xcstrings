    "Select a clip or annotation to move, scale, turn or fade it, and to key it over time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Clip oder eine Anmerkung, um sie zu bewegen, zu skalieren, zu drehen oder auszublenden und über die Zeit zu animieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona un clip o una anotación para moverlo, escalarlo, girarlo o fundirlo, y para animarlo con fotogramas clave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez un clip ou une annotation pour le déplacer, le redimensionner, le faire pivoter ou l'estomper, et pour l'animer dans le temps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona una clip o un'annotazione per spostarla, scalarla, ruotarla o dissolverla, e per animarla nel tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップか注釈を選択すると、移動、拡大・縮小、回転、フェードや、時間に沿ったキーフレームの設定ができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클립이나 주석을 선택하면 이동, 크기 조절, 회전, 페이드를 적용하고 시간에 따라 키프레임을 설정할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione um clipe ou uma anotação para mover, redimensionar, girar ou esmaecer, e para animá-lo com quadros-chave."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择一个片段或注释以移动、缩放、旋转或淡化它，并随时间设置关键帧。"
          }
        }
      }
    },
