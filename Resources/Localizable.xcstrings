    "macOS asks for permission on first use. Mute it from the recording controls." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS fragt bei der ersten Nutzung nach der Berechtigung. Stummschalten kannst du es in der Aufzeichnungssteuerung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS pide permiso la primera vez. Puedes silenciarlo desde los controles de grabación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS demande l'autorisation à la première utilisation. Coupez-le depuis les commandes d'enregistrement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS chiede il permesso al primo utilizzo. Silenzialo dai controlli di registrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初回使用時にmacOSが許可を求めます。収録中はコントロールから消音できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "처음 사용할 때 macOS가 권한을 요청합니다. 녹화 컨트롤에서 음소거할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS pede permissão no primeiro uso. Silencie-o pelos controles de gravação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 会在首次使用时请求权限。可在录制控制中将其静音。"
          }
        }
      }
    },
    "macOS keeps its shortcuts, and Shot uses %@ instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS behält seine Kurzbefehle, und Shot verwendet stattdessen %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS conserva sus atajos y Shot usa %@ en su lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS garde ses raccourcis, et Shot utilise %@ à la place."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS mantiene le sue abbreviazioni e Shot usa invece %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSのショートカットはそのままで、Shotは代わりに%@を使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 단축키는 그대로 두고, Shot은 대신 %@ 키를 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS mantém os atalhos dele, e o Shot usa %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 保留其快捷键，Shot 改用 %@。"
          }
        }
      }
    },
    "macOS only lets Shot find where a browser shows its page once you allow it. Area, Window and Screen work without it." : {},
    "macOS requires Screen Recording access for every capture." : {
      "localizations" : {
        "de" : {
