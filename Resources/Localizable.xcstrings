    "Bug reports and ideas are welcome." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehlerberichte und Ideen sind willkommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se agradecen los informes de errores y las ideas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapports de bugs et idées sont les bienvenus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
