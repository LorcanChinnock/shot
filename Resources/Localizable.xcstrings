    },
    "Shows a panel beside the canvas for the screenshot's background, padding, size, shadow and corners, or the selected image's, shape's or text's shadow and border." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt neben der Leinwand einen Bereich für Hintergrund, Rand, Größe, Schatten und Ecken des Bildschirmfotos oder für Schatten und Rahmen des ausgewählten Bilds, der Form oder des Texts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra un panel junto al lienzo para el fondo, el margen, el tamaño, la sombra y las esquinas de la captura, o la sombra y el borde de la imagen, forma o texto seleccionados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche à côté du canevas un panneau pour le fond, la marge, la taille, l’ombre et les coins de la capture, ou l’ombre et la bordure de l’image, de la forme ou du texte sélectionnés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra accanto alla tela un pannello per sfondo, margine, dimensioni, ombra e angoli della schermata, oppure ombra e bordo dell’immagine, forma o testo selezionati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャンバスの横にパネルを表示し、スクリーンショットの背景、余白、サイズ、影、角、または選択した画像・図形・テキストの影と枠線を設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캔버스 옆에 패널을 표시해 스크린샷의 배경, 여백, 크기, 그림자, 모서리 또는 선택한 이미지·도형·텍스트의 그림자와 테두리를 설정합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra um painel ao lado da tela para o fundo, a margem, o tamanho, a sombra e os cantos da captura, ou a sombra e a borda da imagem, forma ou texto selecionados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在画布旁显示面板，用于设置截图的背景、边距、尺寸、阴影和圆角，或所选图像、形状或文本的阴影和边框。"
          }
        }
      }
    },
    "Shows a panel beside the video for the selected clip's or annotation's position, scale, keyframes and style." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
