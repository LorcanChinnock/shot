    "Guide lines through the pointer across the screen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hilfslinien durch den Zeiger über den ganzen Bildschirm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Líneas guía que cruzan la pantalla por el puntero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lignes de repère traversant l’écran par le pointeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linee guida che attraversano lo schermo passando per il puntatore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
