    "Cut" : {
      "comment" : "Video editor timeline: the badge where a section was cut out, before its length, as in CUT 1.2s.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausschneiden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cortar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couper"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taglia"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カット"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잘라내기"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recortar"
          }
        },
        "zh-Hans" : {
