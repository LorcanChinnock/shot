      }
    },
    "Keeps what's inside the crop. Picking another tool, Copy or Save does too, and Undo takes it back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behält, was im Zuschnitt liegt. Ein anderes Werkzeug, Kopieren oder Sichern tun das auch, und Widerrufen nimmt es zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva lo que hay dentro del recorte. Elegir otra herramienta, Copiar o Guardar también lo hacen, y Deshacer lo revierte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde ce qui est dans le recadrage. Choisir un autre outil, Copier ou Enregistrer le font aussi, et Annuler revient en arrière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene ciò che è dentro il ritaglio. Anche scegliere un altro strumento, Copia o Salva lo fanno, e Annulla lo annulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切り取り範囲の内側を残します。ほかのツールを選ぶ、コピー、保存でも同じように適用され、取り消すで元に戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자르기 영역 안쪽을 남깁니다. 다른 도구를 고르거나 복사 또는 저장해도 적용되며, 실행 취소로 되돌릴 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém o que está dentro do recorte. Escolher outra ferramenta, Copiar ou Salvar também fazem isso, e Desfazer volta atrás."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留裁剪框内的内容。选择其他工具、拷贝或存储也会应用裁剪，撤销可将其还原。"
          }
        }
      }
    },
    "Keeps what's inside the crop. Undo takes it back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behält, was im Zuschnitt liegt. Widerrufen macht es rückgängig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva lo que queda dentro del recorte. Deshacer lo revierte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde ce qui est dans le recadrage. Annuler revient en arrière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene ciò che è dentro il ritaglio. Annulla lo ripristina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切り取り枠の内側を残します。取り消すと元に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자르기 영역 안쪽을 남깁니다. 실행 취소로 되돌릴 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém o que está dentro do recorte. Desfazer reverte."
