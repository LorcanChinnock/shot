            "state" : "translated",
            "value" : "K ajoute une image clé à toutes les propriétés à la fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K aggiunge un fotogramma chiave a tutte le proprietà insieme."
          }
