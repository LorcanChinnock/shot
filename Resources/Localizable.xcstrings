    "Pinch, or scroll with ⌘ held, to zoom. Scroll, Space-drag or press H to move around. Actual Size is ⌘1." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Zoomen mit zwei Fingern auf- und zuziehen oder mit gedrückter ⌘-Taste scrollen. Scrolle, ziehe mit gedrückter Leertaste oder drücke H, um dich zu bewegen. Originalgröße ist ⌘1."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pellizca, o desplázate con ⌘ pulsada, para hacer zoom. Desplázate, arrastra con la barra espaciadora o pulsa H para moverte. Tamaño real es ⌘1."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pincez, ou faites défiler en maintenant ⌘, pour zoomer. Faites défiler, glissez avec Espace ou appuyez sur H pour vous déplacer. Taille réelle : ⌘1."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pizzica, o scorri tenendo premuto ⌘, per lo zoom. Scorri, trascina con la barra spaziatrice o premi H per spostarti. Dimensioni reali è ⌘1."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピンチするか、⌘ を押しながらスクロールで拡大縮小。スクロール、スペースを押しながらドラッグ、または H キーで移動。実際のサイズは ⌘1。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "핀치하거나 ⌘를 누른 채 스크롤해 확대·축소합니다. 스크롤하거나, 스페이스를 누른 채 드래그하거나, H를 눌러 이동합니다. 실제 크기는 ⌘1입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça pinça, ou role com ⌘ pressionada, para dar zoom. Role, arraste com Espaço ou pressione H para se mover. Tamanho Real é ⌘1."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双指捏合，或按住 ⌘ 滚动来缩放。滚动、按住空格键拖移或按 H 来四处移动。实际大小为 ⌘1。"
          }
        }
      }
    },
    "Pinned %@" : {
      "localizations" : {
        "de" : {
