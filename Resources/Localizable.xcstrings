    "Shot comes with no warranty. It updates itself with Sparkle, under the MIT license." : {

    },
    "Shot found no text in this screenshot." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shot hat in diesem Bildschirmfoto keinen Text gefunden."
          }
        },
