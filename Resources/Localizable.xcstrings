    "Select a clip or annotation to move, scale, turn or fade it, and to key it over time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Clip oder eine Anmerkung, um sie zu bewegen, zu skalieren, zu drehen oder auszublenden und über die Zeit zu animieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona un clip o una anotación para moverlo, escalarlo, girarlo o fundirlo, y para animarlo con fotogramas clave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez un clip ou une annotation pour le déplacer, le redimensionner, le faire pivoter ou l'estomper, et pour l'animer dans le temps."
          }
        },
