    "The image is as big as Shot can stitch. Press Return to save it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Bild hat die maximale Größe erreicht, die Shot zusammenfügen kann. Drück Return, um es zu sichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La imagen ya tiene el tamaño máximo que Shot puede unir. Pulsa Retorno para guardarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
