    "Captures look the same either way." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufnahmen sehen in beiden Fällen gleich aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las capturas se ven igual en ambos casos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les captures restent identiques dans les deux cas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le catture restano uguali in entrambi i casi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャプチャの見た目はどちらでも変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캡처는 어느 쪽이든 똑같이 보입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As capturas ficam iguais em qualquer caso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "截图在两种模式下看起来都一样。"
          }
        }
      }
    },
    "Cards stay until you close them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karten bleiben, bis du sie schließt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tarjetas se quedan hasta que las cierres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cartes restent jusqu’à ce que vous les fermiez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le schede restano finché non le chiudi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードは閉じるまで表示されたままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카드는 닫을 때까지 그대로 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os cartões ficam até você fechá-los."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片会一直显示，直到你关闭它们。"
          }
        }
      }
    },
    "Check the frame and options before every recording. Hold ⌥ as you finish the selection to check once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe Rahmen und Optionen vor jeder Aufnahme. Halte ⌥ beim Abschließen der Auswahl gedrückt, um sie einmalig zu prüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa el marco y las opciones antes de cada grabación. Mantén pulsada ⌥ al terminar la selección para revisarlos una vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez le cadre et les options avant chaque enregistrement. Maintenez ⌥ en terminant la sélection pour les vérifier une seule fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla la cornice e le opzioni prima di ogni registrazione. Tieni premuto ⌥ mentre completi la selezione per controllarle una volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "収録のたびに枠とオプションを確認します。選択を終えるときに ⌥ を押すと、その回だけ確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녹화할 때마다 프레임과 옵션을 확인합니다. 선택을 마칠 때 ⌥를 누르고 있으면 한 번만 확인합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confira o quadro e as opções antes de cada gravação. Segure ⌥ ao terminar a seleção para conferir uma vez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次录制前检查画框和选项。完成选择时按住 ⌥ 可仅检查这一次。"
          }
        }
      }
    },
    "Choose a different folder…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anderen Ordner auswählen …"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elegir otra carpeta…"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisir un autre dossier…"
          }
        },
        "it" : {
          "stringUnit" : {
