[
  {"name": "annotate", "args": ["annotate", "{base}", "--json", "{fixtures}/marks.json", "-o", "{out}"]},
  {"name": "annotateText", "args": ["annotate", "{base}", "--json", "{fixtures}/text.json", "-o", "{out}"], "block": 20},
  {"name": "redactPixelate", "args": ["redact", "{base}", "--rect", "10,10,60,40", "--rect", "100,70,50,40", "-o", "{out}"]},
  {"name": "redactBlur", "args": ["redact", "{base}", "--rect", "20,30,90,50", "--style", "blur", "-o", "{out}"]},
  {"name": "crop", "args": ["crop", "{base}", "--rect", "30,20,100,70", "-o", "{out}"]},
  {"name": "diff", "args": ["diff", "{base}", "{lines}", "-o", "{out}"]},
  {"name": "edit", "args": ["edit", "{base}", "--json", "{\"pad\": 16, \"background\": \"white\", \"style\": {\"shadow\": \"soft\", \"corners\": 10, \"border\": \"solid\"}, \"marks\": [{\"type\": \"arrow\", \"from\": [20, 100], \"to\": [120, 30]}], \"place\": [{\"path\": \"{lines}\", \"at\": [100, 70], \"width\": 48}]}", "-o", "{out}"]},
  {"name": "infoVideo", "args": ["info", "{timed}"], "out": "none"},
  {"name": "gif", "args": ["gif", "{timed}", "--start", "0.5", "--end", "1.5", "--fps", "10", "--width", "80", "-o", "{out}"], "out": "gif"},
  {"name": "trim", "args": ["trim", "{timed}", "--start", "0.5", "--end", "1.5", "-o", "{out}"], "out": "mp4"},
  {"name": "editVideo", "args": ["edit", "{timed}", "--json", "{\"cut\": [[0.5, 1]], \"crop\": [20, 10, 120, 100], \"marks\": [{\"start\": 0, \"end\": 2, \"type\": \"rectangle\", \"rect\": [30, 20, 60, 40], \"color\": \"red\"}]}", "-o", "{out}"], "out": "mp4"},
  {"name": "speed", "args": ["edit", "{timed}", "--json", "{\"cut\": [[0.5, 1]], \"speed\": 2}", "-o", "{out}"], "out": "mp4"},
  {"name": "editGIF", "args": ["edit", "{timed}", "--json", "{\"keep\": [[0, 1]], \"format\": \"gif\", \"fps\": 10, \"width\": 80, \"marks\": [{\"start\": 0, \"end\": 1, \"type\": \"arrow\", \"from\": [20, 100], \"to\": [120, 30], \"color\": \"blue\"}]}", "-o", "{out}"], "out": "gif"},
  {"name": "frames", "args": ["frames", "{timed}", "--every", "0.5", "--width", "80", "-o", "{out}"], "out": "folder"}
]
