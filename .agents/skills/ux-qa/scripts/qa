#!/bin/zsh
# Runs session.sh helpers in one command, for an agent whose every shell call starts a fresh shell:
#   .agents/skills/ux-qa/scripts/qa 'uxqa_click 640 320; sleep 0.5; uxqa_shot after-click'
# Works from any directory. It drives the build/ShotDev.app of the worktree it lives in, and compiles the tools the first
# time, or again when their source has changed.
cd "${0:A:h:h:h:h:h}" || exit 1
source .agents/skills/ux-qa/scripts/session.sh
for tool in input axdump measure window; do
  [[ "$UXQA_DIR/bin/$tool" -nt "$UXQA_SKILL/$tool.swift" ]] || { uxqa_setup || exit 1; break; }
done
eval "$*"
