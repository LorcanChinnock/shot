// Settings every target shares. Debug.xcconfig and Release.xcconfig include this, and each target adds its own file.

// The version release-please bumps. CURRENT_PROJECT_VERSION is the build number; scripts/bundle.sh sets it to the
// commit count, so builds from Xcode say 1.
MARKETING_VERSION = 0.7.0-beta.88 // x-release-please-version
CURRENT_PROJECT_VERSION = 1

SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 15.0
SWIFT_VERSION = 6.0
// The code is written for Swift 6's defaults, so new projects' main-actor-by-default isolation stays off.
SWIFT_DEFAULT_ACTOR_ISOLATION = nonisolated
SWIFT_APPROACHABLE_CONCURRENCY = NO
SWIFT_STRICT_CONCURRENCY = complete
// Lets the targets share declarations marked `package` (GIFStreamWriter, for one) without making them public.
SWIFT_PACKAGE_NAME = Shot

// macOS ties the Screen Recording permission to the signature, so every build signs with the same identity:
// scripts/make-dev-cert.sh creates "Shot Dev", and the release workflow signs with "Shot Release". To use another one,
// set CODE_SIGN_IDENTITY in Config/Local.xcconfig, which git ignores.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Shot Dev
DEVELOPMENT_TEAM =
ENABLE_HARDENED_RUNTIME = NO

// Each build extracts the strings the app shows; scripts/strings.sh syncs them into Resources/Localizable.xcstrings.
SWIFT_EMIT_LOC_STRINGS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
STRING_CATALOG_GENERATE_SYMBOLS = NO

ALWAYS_SEARCH_USER_PATHS = NO
DEAD_CODE_STRIPPING = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
ENABLE_MODULE_VERIFIER = NO
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = NO
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
GCC_C_LANGUAGE_STANDARD = gnu17
CLANG_CXX_LANGUAGE_STANDARD = gnu++20
